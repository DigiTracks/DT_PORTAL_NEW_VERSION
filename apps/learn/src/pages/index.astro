---
import LearningHome from "@digitracks/ui/components/LearningHome.astro";
import OriginLayout from "@digitracks/ui/components/OriginLayout.astro";
import { routeRegistry } from "@digitracks/seo";

const route = routeRegistry.find((item) => item.origin === "learn" && item.path === "/")!;
const navItems = [
  { label: "Learning paths", href: "/#learning-paths" },
  { label: "SourceCraft", href: "https://sourcecraft.digitracks.net/" },
  { label: "LearnPMO", href: "https://learnpmo.digitracks.net/" },
  { label: "HCM Fusion", href: "https://hcmfusion.digitracks.net/" }
];
---

<OriginLayout route={route} brandSuffix="Learn" navItems={navItems} requestLabel="Talk to the studio" bodyClass="page-learning-home">
  <LearningHome />
</OriginLayout>
