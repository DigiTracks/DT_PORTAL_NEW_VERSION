---
import LegalPage from "@digitracks/ui/components/LegalPage.astro";
import OriginLayout from "@digitracks/ui/components/OriginLayout.astro";
import type { RouteRecord } from "@digitracks/seo";

const route: RouteRecord = {
  id: "learn:/terms/",
  origin: "learn",
  path: "/terms/",
  routeClass: "public-utility",
  indexable: true,
  title: "Terms of use | Digi Tracks Learning",
  description: "The terms that apply to the free Digi Tracks learning material, practice tools and saved work.",
  template: "legal",
  breadcrumbs: [{ label: "Home", path: "/" }, { label: "Terms of Use", path: "/terms/" }],
  ctaIds: [],
  analyticsId: "route:learn:terms",
  canonicalOrigin: "https://learn.digitracks.net",
};
const navItems = [
  { label: "Learning paths", href: "/#learning-paths" },
  { label: "SourceCraft", href: "https://sourcecraft.digitracks.net/" },
  { label: "LearnPMO", href: "https://learnpmo.digitracks.net/" },
  { label: "HCM Fusion", href: "https://hcmfusion.digitracks.net/" }
];
---

<OriginLayout route={route} brandSuffix="Learn" navItems={navItems} requestLabel="Talk to the studio" bodyClass="page-learning-entry">
  <LegalPage route={route} />
</OriginLayout>