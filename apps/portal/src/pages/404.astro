---
import PageHero from "@digitracks/ui/components/PageHero.astro";
import SiteLayout from "@digitracks/ui/components/SiteLayout.astro";
import Button from "@digitracks/ui/components/Button.astro";
import "@digitracks/ui/styles/base.css";
import commonStyles from "@digitracks/ui/styles/portal-common.css?inline";

const popular = [
  { name: "MIND ONE Professional", href: "/products/mindone-pro/", note: "Interview practice, Basic and Professional editions" },
  { name: "Vedik", href: "/products/vedik/", note: "Admissions, learning and placement" },
  { name: "Vertex", href: "/products/vertex/", note: "Project and procurement management" },
  { name: "Chronos", href: "/products/chronos/", note: "Clinic operations and records" }
];

const paths = [
  { name: "All products", href: "/products/" },
  { name: "Industry paths", href: "/solutions/#industry-paths" },
  { name: "Solutions", href: "/solutions/" },
  { name: "Services", href: "/services/" },
  { name: "Learn", href: "https://learn.digitracks.net/" },
  { name: "Contact", href: "/contact/" }
];
---

<SiteLayout title="Page not found | DigiTracks" description="This page does not exist." origin="https://digitracks.net/" indexable={false} pageStyles={commonStyles}>
  <PageHero id="not-found-title" title="This page is not here." eyebrow="404" lede="The address may be wrong, or the page may have moved. Search the catalogue, or start from one of the paths below." compact>
    <Button href="/products/">Browse products</Button>
    <Button href="/" variant="secondary">Return home</Button>
  </PageHero>

  <section class="nf nf-section" aria-labelledby="nf-search-title">
    <div class="shell nf__grid">
      <div class="nf__search">
        <p class="t-label">Search the catalogue</p>
        <h2 id="nf-search-title" class="nf__heading">Look for the product.</h2>
        <form class="nf-form" action="/products/" method="get" role="search">
          <input id="nf-query" name="q" type="search" aria-label="Search products" placeholder="Product, workflow or category" autocomplete="off" />
          <button type="submit">Search<span aria-hidden="true">→</span></button>
        </form>
      </div>
      <div class="nf__paths">
        <p class="t-label">Common destinations</p>
        <ul>{paths.map((item, index) => <li><a href={item.href}><span class="nf__num">{String(index + 1).padStart(2, "0")}</span><span>{item.name}</span><i aria-hidden="true">↗</i></a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="nf-pop nf-section" aria-labelledby="nf-popular-title">
    <div class="shell">
      <div class="section-head"><div><p class="t-label">Popular</p><h2 id="nf-popular-title">Start with a flagship.</h2></div><p>Four products people open most often from the catalogue.</p></div>
      <ul class="nf-pop__grid">{popular.map((item) => <li><a href={item.href}><strong>{item.name}<i aria-hidden="true">→</i></strong><span>{item.note}</span></a></li>)}</ul>
    </div>
  </section>

  <style>
    .nf-section { padding-block: clamp(2.4rem, 4vw, 3.6rem); }
    .nf__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
    .nf__heading { margin: 0.5rem 0 1.2rem; font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.4rem); font-weight: 500; letter-spacing: -0.035em; color: var(--ink); }
    .nf-form { display: flex; gap: 0.5rem; max-width: 34rem; }
    .nf-form input { flex: 1; min-width: 0; padding: 0.85rem 1rem; border: 1px solid rgb(13 27 46 / 22%); background: var(--paper-bright); color: var(--ink); font: inherit; font-size: 0.98rem; }
    .nf-form input:focus-visible { outline: 2px solid var(--signal-deep); outline-offset: 2px; }
    .nf-form button { display: inline-flex; gap: 0.5rem; align-items: center; padding: 0.85rem 1.15rem; border: 1px solid var(--ink); background: var(--ink); color: var(--paper-bright); font: inherit; font-size: 0.95rem; cursor: pointer; }
    .nf-form button:hover { background: var(--night); }
    .nf__paths ul { margin: 0.4rem 0 0; padding: 0; list-style: none; border-top: 1px solid rgb(13 27 46 / 14%); }
    .nf__paths a { display: flex; gap: 0.8rem; align-items: center; padding: 0.65rem 0; border-bottom: 1px solid rgb(13 27 46 / 10%); color: var(--ink); text-decoration: none; font-size: 0.95rem; }
    .nf__num { color: #8a6114; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.14em; }
    .nf__paths a i { margin-left: auto; color: #7b8698; font-style: normal; }
    .nf__paths a:hover { color: var(--night); }
    .nf-pop__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: rgb(13 27 46 / 14%); }
    .nf-pop__grid a { display: grid; gap: 0.45rem; height: 100%; padding: 1.3rem 1.2rem; background: var(--paper-bright); color: inherit; text-decoration: none; }
    .nf-pop__grid strong { display: flex; gap: 0.5rem; align-items: baseline; font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
    .nf-pop__grid strong i { font-size: 0.95rem; font-style: normal; opacity: 0; transform: translateX(-3px); transition: opacity 160ms ease, transform 160ms ease; }
    .nf-pop__grid a:hover strong i { opacity: 1; transform: translateX(0); }
    .nf-pop__grid span { color: #4a5567; font-size: 0.88rem; line-height: 1.45; }
    .nf-pop__grid a:hover { background: #fffdf6; }
    @media (max-width: 900px) { .nf__grid { grid-template-columns: 1fr; } .nf-pop__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 560px) { .nf-pop__grid { grid-template-columns: 1fr; } .nf-form { flex-direction: column; } }
  </style>
</SiteLayout>
