---
import SiteLayout from "@digitracks/ui/components/SiteLayout.astro";
import Button from "@digitracks/ui/components/Button.astro";
import "@digitracks/ui/styles/base.css";
import commonStyles from "@digitracks/ui/styles/portal-common.css?inline";

const groups = [
  {
    index: "01",
    label: "How the software is built",
    items: [
      { title: "Engineering", href: "/engineering/", body: "The stack, the release routine and the constraints behind each product.", meta: "Practice" },
      { title: "Offline-first software", href: "/offline-first-software/", body: "Why the systems keep working when the connection does not.", meta: "Architecture" },
      { title: "Trust and security", href: "/trust/", body: "Deployment, data handling, access control and the security pack.", meta: "Trust" }
    ]
  },
  {
    index: "02",
    label: "Before you buy",
    items: [
      { title: "FAQ", href: "/faq/", body: "Deployment, trials, data location, licensing and support, answered plainly.", meta: "Questions" },
      { title: "Services", href: "/services/", body: "Product fit, implementation, migration and support, scoped and owned.", meta: "Engagement" },
      { title: "Solutions", href: "/solutions/", body: "Six capability families mapped to the products that cover the work.", meta: "Capability" }
    ]
  },
  {
    index: "03",
    label: "Learning, free to open",
    items: [
      { title: "Learn hub", href: "https://learn.digitracks.net/", body: "One index for all four platforms. Open any of them directly.", meta: "Free access" },
      { title: "SourceCraft", href: "https://sourcecraft.digitracks.net/", body: "A reference for procurement and delivery terms, with worked examples.", meta: "Free access" },
      { title: "LearnPMO", href: "https://learnpmo.digitracks.net/", body: "Project, programme and portfolio material, including mock exams.", meta: "Free access" }
    ]
  },
  {
    index: "04",
    label: "More from the estate",
    items: [
      { title: "ProcureSherpa", href: "https://procuresherpa.digitracks.net/", body: "Modules, calculators and templates for procurement teams.", meta: "Free access" },
      { title: "HCM Fusion", href: "https://hcmfusion.digitracks.net/", body: "Oracle Fusion HCM module sequences with lab blocks.", meta: "Free access" },
      { title: "Industries", href: "/industries/", body: "Six sectors, each mapped to the products and deployment models that fit.", meta: "Sector" }
    ]
  }
];
---

<SiteLayout
  title="Resources | DigiTracks"
  description="Engineering notes, trust material, buyer questions and every learning platform — free to open, linked directly."
  origin="https://digitracks.net/"
  canonical="https://digitracks.net/resources/"
  pageStyles={commonStyles}
>
  <nav class="breadcrumbs shell" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><span aria-current="page">Resources</span></li>
    </ol>
  </nav>

  <section class="rs-hero">
    <div class="shell rs-hero__inner">
      <p class="t-label">Resources / reading before the call</p>
      <h1 class="rs-hero__title" id="resources-title">Everything we publish,<br /><em>in one place.</em></h1>
      <p class="rs-hero__lede">Engineering notes, security material, the questions buyers ask first and all four learning platforms. Nothing here is behind an account.</p>
      <div class="rs-hero__actions">
        <Button href="/products/">Browse the catalogue</Button>
        <Button href="/contact/?intent=consultation" variant="secondary">Ask a question</Button>
      </div>
    </div>
  </section>

  {groups.map((group) => (
    <section class="rs-group" aria-labelledby={"rs-" + group.index}>
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="t-label">{group.index} / {group.label}</p>
            <h2 id={"rs-" + group.index}>{group.label}</h2>
          </div>
          <p>{group.items.length} destinations, each one live.</p>
        </div>
        <ul class="rs-grid">
          {group.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="rs-meta">{item.meta}</span>
                <strong>{item.title}<i aria-hidden="true">↗</i></strong>
                <span class="rs-body">{item.body}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="rs-close">
    <div class="shell rs-close__inner">
      <p class="t-label">Still looking</p>
      <h2>Tell us what you need to find.</h2>
      <p>If a document, a module or a page is not here, ask for it directly and we will point you at the right thing — or write it.</p>
      <Button href="/contact/?intent=consultation">Start a conversation</Button>
    </div>
  </section>

  <style>
    .rs-hero { background: linear-gradient(180deg, var(--paper-bright), var(--paper)); border-bottom: 1px solid rgb(13 27 46 / 12%); }
    .rs-hero__inner { display: grid; gap: 1.1rem; justify-items: start; padding-block: clamp(3.2rem, 6vw, 6rem); }
    .rs-hero__title { margin: 0; font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 4.6rem); font-weight: 500; letter-spacing: -0.045em; line-height: 0.98; color: var(--ink); }
    .rs-hero__title em { font-family: var(--font-editorial); font-style: italic; color: #8a6114; letter-spacing: -0.02em; }
    .rs-hero__lede { max-width: 54ch; margin: 0; color: var(--ink-muted); font-size: clamp(1rem, 1.3vw, 1.12rem); line-height: 1.65; }
    .rs-hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.4rem; }
    .rs-group { padding-block: clamp(2.6rem, 4.4vw, 4.2rem); border-bottom: 1px solid rgb(13 27 46 / 10%); }
    .rs-group:nth-of-type(even) { background: var(--paper); }
    .rs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 1.6rem 0 0; padding: 0; list-style: none; background: rgb(13 27 46 / 14%); }
    .rs-grid li { background: var(--paper-bright); }
    .rs-grid a { display: grid; gap: 0.5rem; height: 100%; padding: 1.5rem 1.4rem; color: inherit; text-decoration: none; }
    .rs-grid a:hover { background: #fffdf6; }
    .rs-meta { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: #8a6114; }
    .rs-grid strong { display: flex; gap: 0.5rem; align-items: baseline; font-family: var(--font-display); font-size: 1.24rem; font-weight: 560; letter-spacing: -0.02em; color: var(--ink); }
    .rs-grid strong i { font-size: 0.9rem; font-style: normal; color: #7b8698; transition: transform 160ms ease, color 160ms ease; }
    .rs-grid a:hover strong i { transform: translate(2px, -2px); color: #8a6114; }
    .rs-body { color: #46536a; font-size: 0.93rem; line-height: 1.55; }
    .rs-close { background: var(--night); color: var(--paper-bright); padding-block: clamp(3.4rem, 6vw, 6rem); }
    .rs-close__inner { display: grid; gap: 1rem; justify-items: start; }
    .rs-close .t-label { color: var(--signal); }
    .rs-close h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 3.2rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; color: var(--paper-bright); }
    .rs-close p { max-width: 56ch; margin: 0; color: rgb(198 212 230 / 88%); line-height: 1.6; }
    @media (max-width: 960px) { .rs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 620px) { .rs-grid { grid-template-columns: 1fr; } }
  </style>
</SiteLayout>
