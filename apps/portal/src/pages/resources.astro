---
import SiteLayout from "@digitracks/ui/components/SiteLayout.astro";
import Button from "@digitracks/ui/components/Button.astro";
import "@digitracks/ui/styles/base.css";
import commonStyles from "@digitracks/ui/styles/portal-common.css?inline";

const groups = [
  {
    index: "01",
    label: "How the software is built",
    lede: "The stack, the release routine and the constraints behind each product.",
    items: [
      { title: "Engineering", href: "/engineering/", body: "The stack, the release routine and the constraints behind each product.", meta: "Practice" },
      { title: "Offline-first software", href: "/offline-first-software/", body: "Why the systems keep working when the connection does not.", meta: "Architecture" },
      { title: "Trust and security", href: "/trust/", body: "Deployment, data handling, access control and the security pack.", meta: "Trust" }
    ]
  },
  {
    index: "02",
    label: "Before you buy",
    lede: "Deployment, trials, data location, licensing and support, answered plainly.",
    items: [
      { title: "FAQ", href: "/faq/", body: "Deployment, trials, data location, licensing and support, answered plainly.", meta: "Questions" },
      { title: "Pricing", href: "/pricing/", body: "Per-product licensing, site licences and implementation, quoted against the scope you approve.", meta: "Commercials" },
      { title: "Services", href: "/services/", body: "Product fit, implementation, migration and support, scoped and owned.", meta: "Engagement" },
      { title: "Solutions", href: "/solutions/", body: "Six capability families mapped to the products that cover the work.", meta: "Capability" }
    ]
  },
  {
    index: "03",
    label: "Learning, free to open",
    lede: "All four learning platforms, open without an account.",
    items: [
      { title: "Learn hub", href: "https://learn.digitracks.net/", body: "One index for all four platforms. Open any of them directly.", meta: "Free access" },
      { title: "SourceCraft", href: "https://sourcecraft.digitracks.net/", body: "A reference for procurement and delivery terms, with worked examples.", meta: "Free access" },
      { title: "LearnPMO", href: "https://learnpmo.digitracks.net/", body: "Project, programme and portfolio material, including mock exams.", meta: "Free access" }
    ]
  },
  {
    index: "04",
    label: "More from the estate",
    lede: "Tools, platforms and the industry paths.",
    items: [
      { title: "ProcureSherpa", href: "https://procuresherpa.digitracks.net/", body: "Modules, calculators and templates for procurement teams.", meta: "Free access" },
      { title: "HCM Fusion", href: "https://hcmfusion.digitracks.net/", body: "Oracle Fusion HCM module sequences with lab blocks.", meta: "Free access" },
      { title: "Industries", href: "/solutions/#industry-paths", body: "Six sectors, each mapped to the products and deployment models that fit.", meta: "Sector" }
    ]
  }
];
---

<SiteLayout
  title="Resources | DigiTracks"
  description="Engineering notes, trust material, buyer questions and every learning platform — free to open, linked directly."
  origin="https://digitracks.net/"
  canonical="https://digitracks.net/resources/"
  pageStyles={commonStyles}
>
  <nav class="breadcrumbs shell" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><span aria-current="page">Resources</span></li>
    </ol>
  </nav>

  <section class="rs-hero">
    <div class="shell rs-hero__inner">
      <p class="t-label">Resources / reading before the call</p>
      <h1 class="rs-hero__title" id="resources-title">Everything we publish,<br /><em>in one place.</em></h1>
      <p class="rs-hero__lede">Engineering notes, security material, the questions buyers ask first and all four learning platforms. Nothing here is behind an account.</p>
      <div class="rs-hero__actions">
        <Button href="/products/">Browse the catalogue</Button>
        <Button href="/contact/?intent=consultation" variant="secondary">Ask a question</Button>
      </div>
    </div>
  </section>

  {groups.map((group, groupIndex) => (
    <section class={"rs-group" + (groupIndex % 2 === 1 ? " rs-group--tint" : "")} aria-labelledby={"rs-" + group.index}>
      <div class="shell">
        <div class="section-head rs-group__head">
          <div>
            <p class="t-label">{group.index} / {group.label}</p>
            <h2 id={"rs-" + group.index}>{group.label}</h2>
          </div>
          <p class="rs-group__lede">{group.lede}</p>
        </div>
        <ul class="rs-grid">
          {group.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="rs-meta">{item.meta}</span>
                <strong>{item.title}<i aria-hidden="true">↗</i></strong>
                <span class="rs-body">{item.body}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="rs-close">
    <div class="shell rs-close__inner">
      <p class="t-label">Still looking</p>
      <h2>Tell us what you need to find.</h2>
      <p>If a document, a module or a page is not here, ask for it directly and we will point you at the right thing — or write it.</p>
      <Button href="/contact/?intent=consultation">Start a conversation</Button>
    </div>
  </section>

  <style>
    .rs-hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 56% 92% at 6% -10%, rgb(41 86 230 / 32%), transparent 58%),
        radial-gradient(ellipse 40% 60% at 96% 10%, rgb(143 123 255 / 16%), transparent 62%),
        radial-gradient(ellipse 46% 64% at 80% 116%, rgb(255 197 61 / 12%), transparent 60%),
        var(--night);
    }
    .rs-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(rgb(198 212 230 / 5%) 1px, transparent 1px),
        linear-gradient(90deg, rgb(198 212 230 / 5%) 1px, transparent 1px);
      background-size: 4.5rem 4.5rem;
      mask-image: radial-gradient(ellipse at 70% 40%, #000, transparent 82%);
    }
    .rs-hero__inner { position: relative; display: grid; gap: 1.15rem; justify-items: start; padding-block: clamp(3.8rem, 7vw, 7rem); }
    .rs-hero .t-label { color: var(--signal); }
    .rs-hero__title {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2.7rem, 5.4vw, 5rem);
      font-weight: 500;
      letter-spacing: -0.048em;
      line-height: 0.98;
      color: var(--paper-bright);
      text-wrap: balance;
    }
    .rs-hero__title em {
      background: linear-gradient(12deg, #ffc53d 18%, #ffe08a 64%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-family: var(--font-editorial);
      font-style: italic;
      letter-spacing: -0.02em;
    }
    .rs-hero__lede { max-width: 54ch; margin: 0; color: rgb(214 225 240 / 88%); font-size: clamp(1rem, 1.3vw, 1.12rem); line-height: 1.62; }
    .rs-hero__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 0.55rem; }

    .rs-group { padding-block: clamp(2.8rem, 4.6vw, 4.5rem); border-bottom: 1px solid rgb(13 27 46 / 10%); }
    .rs-group--tint {
      background:
        radial-gradient(ellipse at 100% 0%, rgb(255 197 61 / 7%), transparent 52%),
        linear-gradient(180deg, #f5f2ea, #f2eee2);
    }
    .rs-group__head { align-items: end; }
    .rs-group__head .t-label { color: var(--signal-deep); }
    .rs-group__lede { margin: 0; max-width: 42ch; color: var(--ink-muted); line-height: 1.55; }
    .rs-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(0.9rem, 1.8vw, 1.5rem);
      margin: 1.75rem 0 0;
      padding: 0;
      list-style: none;
    }
    .rs-grid li { display: grid; }
    .rs-grid a {
      position: relative;
      display: grid;
      gap: 0.55rem;
      height: 100%;
      align-content: start;
      padding: 1.6rem 1.5rem 1.7rem;
      color: inherit;
      text-decoration: none;
      border: 1px solid rgb(13 27 46 / 12%);
      border-radius: 15px;
      background: var(--paper-bright);
      overflow: hidden;
      transition: transform 240ms var(--ease-out), border-color 240ms ease, box-shadow 240ms ease;
    }
    .rs-grid a::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 3px;
      background: linear-gradient(90deg, var(--signal) 0%, var(--signal-deep) 60%, var(--aurora-cyan) 100%);
      opacity: 0;
      transition: opacity 240ms ease;
    }
    .rs-grid a:hover {
      transform: translateY(-3px);
      border-color: rgb(41 86 230 / 28%);
      box-shadow: 0 18px 40px rgb(13 27 46 / 11%), 0 0 0 1px rgb(255 197 61 / 12%);
    }
    .rs-grid a:hover::before { opacity: 1; }
    .rs-meta { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: #8a6114; }
    .rs-grid strong {
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
      font-family: var(--font-display);
      font-size: 1.26rem;
      font-weight: 560;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .rs-grid strong i { font-size: 0.9rem; font-style: normal; color: var(--signal-deep); transition: transform 180ms ease, color 180ms ease; }
    .rs-grid a:hover strong i { transform: translate(2px, -2px); color: var(--signal-deep); }
    .rs-body { color: #46536a; font-size: 0.93rem; line-height: 1.58; }

    .rs-close {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 58% 88% at 88% 118%, rgb(255 197 61 / 13%), transparent 58%),
        radial-gradient(ellipse 44% 70% at 4% -10%, rgb(41 86 230 / 25%), transparent 60%),
        linear-gradient(180deg, #0c1830, var(--night));
      color: var(--paper-bright);
      padding-block: clamp(3.8rem, 6.5vw, 6.5rem);
    }
    .rs-close::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, rgb(255 255 255 / 5%) 1px, transparent 1px);
      background-size: 100% 44px;
      mask-image: linear-gradient(180deg, #000, transparent 70%);
    }
    .rs-close__inner { position: relative; display: grid; gap: 1.05rem; justify-items: start; }
    .rs-close .t-label { color: var(--signal); }
    .rs-close h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2.1rem, 4vw, 3.4rem);
      font-weight: 500;
      letter-spacing: -0.042em;
      line-height: 1.02;
      color: var(--paper-bright);
      text-wrap: balance;
    }
    .rs-close p { max-width: 56ch; margin: 0; color: rgb(198 212 230 / 88%); line-height: 1.62; }
    @media (max-width: 960px) { .rs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 620px) { .rs-grid { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .rs-grid a, .rs-grid a::before, .rs-grid strong i { transition: none; } }
  </style>
</SiteLayout>
