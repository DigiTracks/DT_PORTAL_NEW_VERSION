---
import type { RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";

interface Props {
  route: RouteRecord;
}

const { route } = Astro.props;
const requestHref = "/contact/?intent=product-enquiry&product=mindone";
const rows = [
  {
    term: "Positioning",
    basic: "Free, focused entry edition",
    complete: "Full MIND ONE feature access"
  },
  {
    term: "Availability",
    basic: "Pre-launch; request only",
    complete: "Pre-launch; request only"
  },
  {
    term: "Practice foundation",
    basic: "Résumé- and job-description-grounded questions, spoken or typed answers, answer-specific coaching and a structured debrief.",
    complete: "The complete MIND ONE practice and coaching workflow, including the shared grounded practice foundation."
  },
  {
    term: "Session history",
    basic: "Focused in-memory practice sessions. Durable profiles and saved history are not published as Basic scope.",
    complete: "Durable local profiles, sessions and saved practice history are included in the reviewed implementation."
  },
  {
    term: "Career development",
    basic: "Learning goals, progress tracking and role-development maps are not published as Basic scope.",
    complete: "Résumé/JD comparison, learning goals, progress tracking and role-development maps are included in the reviewed implementation."
  },
  {
    term: "Opportunity research",
    basic: "Not published as Basic scope.",
    complete: "Source-attributed remote opportunity listings are included in the reviewed implementation."
  },
  {
    term: "App controls",
    basic: "Not published as Basic scope.",
    complete: "App lock and diagnostics are included in the reviewed implementation."
  },
  {
    term: "Hosted AI and data",
    basic: "Local-only default with optional hosted AI by explicit consent. Provider and retention details require confirmation.",
    complete: "Adds durable local data. Hosted AI remains configurable; provider, retention and entitlement details require confirmation."
  },
  {
    term: "Price and licence",
    basic: "Free positioning is owner-stated. Final licence and commercial terms are not published.",
    complete: "UNKNOWN — Complete pricing, billing and licence terms are not published."
  },
  {
    term: "Usage limits",
    basic: "UNKNOWN — released quotas and session limits are not published.",
    complete: "Full feature access does not mean unmetered hosted AI. Released quotas, provider limits and fair-use rules require confirmation."
  },
  {
    term: "Integrations",
    basic: "No ATS, MCP or other integration has been verified.",
    complete: "No ATS, MCP or other integration has been verified."
  },
  {
    term: "Deployment",
    basic: "UNKNOWN — production deployment details are not published.",
    complete: "UNKNOWN — production deployment details are not published."
  },
  {
    term: "Release timing",
    basic: "UNKNOWN — no approved launch date is published.",
    complete: "UNKNOWN — no approved launch date is published."
  }
] as const;
---

<section class="edition-hero" aria-labelledby="edition-comparison-title">
  <div class="edition-hero__mark" aria-hidden="true">M/ONE</div>
  <div class="shell edition-hero__grid">
    <div>
      <p class="t-label"><span class="signal-dot" aria-hidden="true"></span>MIND ONE / Edition comparison</p>
      <h1 id="edition-comparison-title">Two positions.<br><em>One practice model.</em></h1>
    </div>
    <div class="edition-hero__copy">
      <p>{route.description}</p>
      <p>Basic is the free, focused edition. Complete provides full MIND ONE feature access. Implemented capability is separated from commercial entitlement so the comparison cannot become a sales promise.</p>
      <div class="button-row"><Button href={requestHref} ctaId="request-mindone-access">Ask about edition access</Button><Button href="/products/mindone/" variant="secondary">Explore MIND ONE Basic</Button></div>
    </div>
  </div>
</section>

<section class="edition-matrix-section section" aria-labelledby="edition-matrix-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">Published comparison</p><h2 id="edition-matrix-title">What is known.<br>What is not.</h2></div>
      <p>“UNKNOWN” means the information was not verified in the available product evidence. It does not mean the feature is included or excluded.</p>
    </div>
    <div class="edition-table-wrap" tabindex="0" role="region" aria-label="MIND ONE Basic and Complete comparison, scroll horizontally on small screens">
      <table class="edition-table">
        <caption>Published MIND ONE Basic and MIND ONE Complete positions</caption>
        <thead><tr><th scope="col">Comparison point</th><th scope="col">MIND ONE Basic</th><th scope="col">MIND ONE Complete</th></tr></thead>
        <tbody>
          {rows.map((row) => <tr><th scope="row">{row.term}</th><td>{row.basic}</td><td>{row.complete}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="edition-table-hint">On a small screen, swipe within the comparison or focus it and use the arrow keys.</p>
  </div>
</section>

<section class="edition-decisions section" aria-labelledby="edition-decisions-title">
  <div class="shell edition-decisions__grid">
    <div><p class="t-label">Choose the right conversation</p><h2 id="edition-decisions-title">Start with the requirement, not the label.</h2></div>
    <div class="edition-decisions__cards">
      <article>
        <span>Free / focused practice</span>
        <h3>Evaluate MIND ONE Basic</h3>
        <p>Review the résumé-grounded practice, coaching and debrief scope. Ask for current availability, quotas and data-handling details.</p>
        <Button href="/products/mindone/" variant="secondary">Review Basic</Button>
      </article>
      <article>
        <span>Full feature access</span>
        <h3>Evaluate MIND ONE Complete</h3>
        <p>Review durable history, comparison, progress and role-development tools. Ask for current commercial, provider and deployment terms.</p>
        <Button href="/contact/?intent=product-enquiry&product=mindone-pro" ctaId="request-mindone-access">Request Complete access</Button>
      </article>
    </div>
  </div>
</section>

<section class="edition-questions section" aria-labelledby="edition-questions-title">
  <div class="shell edition-questions__grid">
    <div><p class="t-label">Straight answers</p><h2 id="edition-questions-title">Before you request access.</h2></div>
    <div class="edition-questions__list">
      <details><summary>What does MIND ONE Complete add?</summary><p>The reviewed Complete implementation adds durable local profiles and history, résumé/JD comparison, learning goals, progress tracking, role-development maps, source-attributed opportunity listings, app lock and diagnostics. This verifies implemented scope, not released billing or entitlement enforcement.</p></details>
      <details><summary>Does Complete mean unlimited hosted AI?</summary><p>No. Full feature access does not remove provider quotas, technical limits or fair-use controls. Released quotas and commercial terms still require confirmation.</p></details>
      <details><summary>Can I buy or open a full demo now?</summary><p>Both editions are request-only and pre-launch. The enquiry form records interest; it does not take payment, issue a demo link or grant product access.</p></details>
      <details><summary>Are the two editions connected to Nipuna?</summary><p>No integration between MIND ONE and Nipuna was verified. MIND ONE supports interview practice; Nipuna’s published scope concerns recruiting and deterministic candidate matching.</p></details>
    </div>
  </div>
</section>

<section class="edition-close" aria-labelledby="edition-close-title">
  <div class="shell edition-close__grid"><div><p class="t-label">Next step</p><h2 id="edition-close-title">Ask for the facts that decide the fit.</h2></div><div><p>Tell us which edition you are evaluating and which unknowns matter most. We will respond with confirmed scope rather than a generic demo promise.</p><Button href={requestHref} ctaId="request-mindone-access">Ask about edition access</Button></div></div>
</section>
