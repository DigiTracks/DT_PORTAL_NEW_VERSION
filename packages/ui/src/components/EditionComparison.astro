---
import type { RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";

interface Props {
  route: RouteRecord;
}

const { route } = Astro.props;
const requestHref = "/contact/?intent=product-enquiry&product=mindone";
const rows = [
  {
    term: "Positioning",
    basic: "Free, focused interview practice",
    complete: "Full MIND ONE workspace"
  },
  {
    term: "Availability",
    basic: "Available now",
    complete: "Available now"
  },
  {
    term: "Practice foundation",
    basic: "Résumé- and job-description-grounded questions, spoken or typed answers, answer-specific coaching and a structured debrief.",
    complete: "The complete MIND ONE practice and coaching workflow, including the shared grounded practice foundation."
  },
  {
    term: "Session history",
    basic: "Focused sessions with in-session coaching and a structured debrief.",
    complete: "Durable local profiles, saved sessions and a full practice history."
  },
  {
    term: "Career development",
    basic: "Core practice with a structured debrief.",
    complete: "Résumé/JD comparison, learning goals, progress tracking and role-development maps."
  },
  {
    term: "Opportunity research",
    basic: "Core practice scope.",
    complete: "Source-attributed remote opportunity listings."
  },
  {
    term: "App controls",
    basic: "Standard practice controls.",
    complete: "App lock and diagnostics."
  },
  {
    term: "Hosted AI and data",
    basic: "Local-first sessions. Optional hosted AI with explicit consent.",
    complete: "Local history with configurable hosted AI."
  },
  {
    term: "Price and licence",
    basic: "Free.",
    complete: "Quoted for your team, with the licence agreed before rollout."
  },
  {
    term: "Usage limits",
    basic: "Fair-use limits apply.",
    complete: "Fair-use and provider limits agreed with you in writing."
  },
  {
    term: "Integrations",
    basic: "Scoped with your team.",
    complete: "Scoped with your team."
  },
  {
    term: "Deployment",
    basic: "Browser, local-first.",
    complete: "Hosted or in your environment."
  },
  {
    term: "Release timing",
    basic: "Available now",
    complete: "Available now"
  }
] as const;
---

<section class="edition-hero" aria-labelledby="edition-comparison-title">
  <div class="edition-hero__mark" aria-hidden="true">M/ONE</div>
  <div class="shell edition-hero__grid">
    <div>
      <p class="t-label"><span class="signal-dot" aria-hidden="true"></span>MIND ONE / Edition comparison</p>
      <h1 id="edition-comparison-title">Two positions.<br><em>One practice model.</em></h1>
    </div>
    <div class="edition-hero__copy">
      <p>{route.description}</p>
      <p>Basic is the free, focused edition. Professional provides the full MIND ONE workspace. Both are available now, and we confirm access, pricing and rollout with your team.</p>
      <div class="button-row"><Button href={requestHref} ctaId="request-mindone-access">Get edition access</Button><Button href="/products/mindone/" variant="secondary">Explore MIND ONE Basic</Button></div>
    </div>
  </div>
</section>

<section class="edition-matrix-section section" aria-labelledby="edition-matrix-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">Edition comparison</p><h2 id="edition-matrix-title">Choose the work.<br>Compare the editions.</h2></div>
      <p>Both editions share the same grounded practice model. The comparison below shows what each edition adds.</p>
    </div>
    <div class="edition-table-wrap" tabindex="0" role="region" aria-label="MIND ONE Basic and Professional comparison, scroll horizontally on small screens">
      <table class="edition-table">
        <caption>MIND ONE Basic and MIND ONE Professional compared</caption>
        <thead><tr><th scope="col">Comparison point</th><th scope="col">MIND ONE Basic</th><th scope="col">MIND ONE Professional</th></tr></thead>
        <tbody>
          {rows.map((row) => <tr><th scope="row">{row.term}</th><td>{row.basic}</td><td>{row.complete}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="edition-table-hint">On a small screen, swipe within the comparison or focus it and use the arrow keys.</p>
  </div>
</section>

<section class="edition-decisions section" aria-labelledby="edition-decisions-title">
  <div class="shell edition-decisions__grid">
    <div><p class="t-label">Choose the right conversation</p><h2 id="edition-decisions-title">Start with the requirement, not the label.</h2></div>
    <div class="edition-decisions__cards">
      <article>
        <span>Free / focused practice</span>
        <h3>Start with MIND ONE Basic</h3>
        <p>Grounded questions, spoken or typed answers, answer-specific coaching and a structured debrief. Free to use now.</p>
        <Button href="/products/mindone/" variant="secondary">Explore Basic</Button>
      </article>
      <article>
        <span>Full feature access</span>
        <h3>Talk to us about MIND ONE Professional</h3>
        <p>Durable history, résumé/JD comparison, progress and role-development tools, with access and rollout agreed for your team.</p>
        <Button href="/contact/?intent=product-enquiry&product=mindone-pro" ctaId="request-mindone-access">Get Professional access</Button>
      </article>
    </div>
  </div>
</section>

<section class="edition-questions section" aria-labelledby="edition-questions-title">
  <div class="shell edition-questions__grid">
    <div><p class="t-label">Straight answers</p><h2 id="edition-questions-title">Before you get started.</h2></div>
    <div class="edition-questions__list">
      <details><summary>What does MIND ONE Professional add?</summary><p>Durable local profiles and history, résumé/JD comparison, learning goals, progress tracking, role-development maps, source-attributed opportunity listings, app lock and diagnostics.</p></details>
      <details><summary>Does Professional mean unlimited hosted AI?</summary><p>Hosted AI follows the provider plan and fair-use limits we agree with you. We put the limits in writing before rollout.</p></details>
      <details><summary>Can I start now?</summary><p>Yes. Basic is free and available now. Professional is activated through a short conversation with our team.</p></details>
      <details><summary>Are the editions connected to Nipuna?</summary><p>They are separate products today. If you want them connected, we scope that with your team.</p></details>
    </div>
  </div>
</section>

<section class="edition-close" aria-labelledby="edition-close-title">
  <div class="shell edition-close__grid"><div><p class="t-label">Next step</p><h2 id="edition-close-title">Ready when you are.</h2></div><div><p>Tell us which edition fits and what your team needs. We will confirm scope, access and a start date.</p><Button href={requestHref} ctaId="request-mindone-access">Get edition access</Button></div></div>
</section>
