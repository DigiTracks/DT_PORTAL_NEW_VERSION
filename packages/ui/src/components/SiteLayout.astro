---
import { origins, socialCardUrl } from "@digitracks/seo";
import BrandLockup from "./BrandLockup.astro";
import "@fontsource-variable/host-grotesk";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";

interface Props {
  title: string;
  description: string;
  origin: string;
  canonical?: string;
  indexable?: boolean;
  socialImage?: string;
  manifestHref?: string;
  structuredData?: string;
  pageStyles?: string;
  navItems?: Array<{ label: string; href: string }>;
  requestLabel?: string;
  requestHref?: string;
  brandSuffix?: string;
  originId?: string;
  mainClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  origin,
  canonical,
  indexable = true,
  socialImage,
  manifestHref,
  structuredData,
  pageStyles,
  navItems = [{ label: "Products", href: "/products/" }, { label: "Solutions", href: "/solutions/" }, { label: "Industries", href: "/industries/" }, { label: "Learning", href: "https://learn.digitracks.net/" }],
  requestLabel = "Start a conversation",
  requestHref = `${origin}contact/?intent=consultation`,
  brandSuffix,
  originId = "portal",
  mainClass,
  bodyClass
} = Astro.props;

const isPortal = originId === "portal";
const headerOnDark = originId === "procuresherpa";
const footerOnDark = originId === "learn" || originId === "procuresherpa" || originId === "learnpmo" || originId === "hcmfusion";
const themeColors: Record<string, string> = {
  portal: "#f6efdc",
  learn: "#fffaf0",
  sourcecraft: "#f6efd9",
  procuresherpa: "#0d2f27",
  learnpmo: "#fbf2dc",
  hcmfusion: "#fff7f2"
};
const estateLinks = [
  { label: "Portal", href: "https://digitracks.net/" },
  { label: "Learn", href: "https://learn.digitracks.net/" },
  { label: "SourceCraft", href: "https://sourcecraft.digitracks.net/" },
  { label: "ProcureSherpa", href: "https://procuresherpa.digitracks.net/" },
  { label: "LearnPMO", href: "https://learnpmo.digitracks.net/" },
  { label: "HCM Fusion", href: "https://hcmfusion.digitracks.net/" }
];
const flagshipLinks = [
  { label: "MIND ONE Basic", href: "https://digitracks.net/products/mindone/", note: "Free focused interview practice" },
  { label: "MIND ONE Complete", href: "https://digitracks.net/products/mindone-pro/", note: "Full MIND ONE feature access" },
  { label: "Vedik", href: "https://digitracks.net/products/vedik/", note: "Education ecosystem" },
  { label: "Campus Grid", href: "https://digitracks.net/products/campus-grid/", note: "Placement within the Vedik portfolio" },
  { label: "Nipuna", href: "https://digitracks.net/products/nipuna/", note: "Local-first recruiting" }
];
const engineeringLinks = [
  { label: "Orion", href: "https://digitracks.net/products/orion/", note: "Code intelligence" },
  { label: "Orion Hunter", href: "https://digitracks.net/products/orion-hunter/", note: "Security reasoning" },
  { label: "Recon", href: "https://digitracks.net/products/recon/", note: "Engineering delivery" },
  { label: "OpsPilot", href: "https://digitracks.net/products/opspilot/", note: "Project operations" }
];
const procurementLinks = [
  { label: "Procurement ecosystem", href: "https://digitracks.net/procurement-software/" },
  { label: "Vertex", href: "https://digitracks.net/products/vertex/" },
  { label: "Vantor", href: "https://digitracks.net/products/vantor/" },
  { label: "Procure5", href: "https://digitracks.net/products/procure5/" },
  { label: "Procure Sherpa", href: "https://digitracks.net/products/sherpa-toolkit/" },
  { label: "ProcureSherpa Learning", href: "https://procuresherpa.digitracks.net/" }
];
type ResourceLink = { label: string; href: string; note: string; external: boolean };
type ResourceGroup = { label: string; links: ResourceLink[] };
const learningLinks = [
  { label: "Learn", href: "https://learn.digitracks.net/" },
  { label: "Source Craft", href: "https://sourcecraft.digitracks.net/" },
  { label: "LearnPMO", href: "https://learnpmo.digitracks.net/" },
  { label: "HCM Fusion", href: "https://hcmfusion.digitracks.net/" },
  { label: "ProcureSherpa Learning", href: "https://procuresherpa.digitracks.net/" }
];
const resourceGroups: ResourceGroup[] = [
  {
    label: "Engineering & trust",
    links: [
      { label: "Engineering", href: "/engineering/", note: "How the products are built and run", external: false },
      { label: "Offline-first software", href: "/offline-first-software/", note: "Why the systems work without a connection", external: false },
      { label: "Trust", href: "/trust/", note: "Security, data handling and access", external: false },
      { label: "FAQ", href: "/faq/", note: "The questions buyers ask first", external: false }
    ]
  }
];
const companyLinks = [
  { label: "About Digi Tracks", href: "https://digitracks.net/about/" },
  { label: "Services", href: "https://digitracks.net/services/" },
  { label: "Solutions", href: "https://digitracks.net/solutions/" },
  { label: "Industries", href: "https://digitracks.net/industries/" },
  { label: "Resources", href: "https://digitracks.net/resources/" },
  { label: "Contact", href: "https://digitracks.net/contact/" }
];
const canonicalUrl = canonical ? new URL(canonical, origin) : undefined;
const generatedSocialImage = indexable && canonicalUrl
  ? socialCardUrl(canonicalUrl.origin, canonicalUrl.pathname)
  : undefined;
const absoluteSocialImage = socialImage
  ? new URL(socialImage, origin).toString()
  : generatedSocialImage;
const previewOrigins = origins.map((item, index) => ({ production: item.origin, local: `http://127.0.0.1:${4321 + index}` }));
---

<!doctype html>
<html lang="en" data-type="software" data-radius="sharp" data-buttons="arrow" data-motion data-origin={originId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, follow"} />
    <meta name="theme-color" content={themeColors[originId] ?? themeColors.portal} />
    {manifestHref && <link rel="manifest" href={manifestHref} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script>document.documentElement.classList.add("m-enter");setTimeout(()=>document.documentElement.classList.remove("m-enter"),1100)</script>
    <script is:inline define:vars={{ previewOrigins, currentProduction: origin }}>
      (() => {
        const isLoopbackHostname = (hostname) => {
          let host = hostname.trim().toLowerCase();
          if (host.startsWith("[") && host.endsWith("]")) host = host.slice(1, -1);
          host = host.replace(/\.$/, "");
          if (host === "localhost" || host === "::1") return true;
          if (/^127(?:\.\d{1,3}){3}$/.test(host)) {
            return host.split(".").slice(1).every((octet) => Number(octet) <= 255);
          }
          if (!host.includes(":")) return false;
          try {
            const canonical = new URL(`http://[${host}]/`).hostname.slice(1, -1);
            if (canonical === "::1") return true;
            const mapped = /^::ffff:([0-9a-f]{1,4}):([0-9a-f]{1,4})$/.exec(canonical);
            if (!mapped) return false;
            const high = Number.parseInt(mapped[1], 16);
            return high >= 0x7f00 && high <= 0x7fff;
          } catch {
            return false;
          }
        };
        if (!isLoopbackHostname(window.location.hostname)) return;

        const normalizedHostname = (hostname) => hostname.toLowerCase().replace(/\.$/, "");
        const previewByHostname = new Map(previewOrigins.map((item) => {
          const production = new URL(item.production);
          return [normalizedHostname(production.hostname), { ...item, productionOrigin: production.origin }];
        }));
        const currentOrigin = new URL(currentProduction).origin;
        const rewriteAnchor = (anchor) => {
          const href = anchor.getAttribute("href");
          if (!href) return;
          let target;
          try {
            target = new URL(href, document.baseURI);
          } catch {
            return;
          }
          if (target.protocol !== "http:" && target.protocol !== "https:") return;
          const preview = previewByHostname.get(normalizedHostname(target.hostname));
          if (!preview) return;
          const localBase = preview.productionOrigin === currentOrigin ? window.location.origin : preview.local;
          const local = new URL(localBase);
          local.pathname = target.pathname;
          local.search = target.search;
          local.hash = target.hash;
          if (local.href !== anchor.href) anchor.setAttribute("href", local.href);
        };
        const rewriteEventTarget = (event) => {
          if (!(event.target instanceof Element)) return;
          const anchor = event.target.closest("a[href]");
          if (anchor instanceof HTMLAnchorElement) rewriteAnchor(anchor);
        };
        const rewriteTree = (root = document) => {
          if (root instanceof HTMLAnchorElement) rewriteAnchor(root);
          root.querySelectorAll("a[href]").forEach(rewriteAnchor);
        };

        document.addEventListener("click", rewriteEventTarget, true);
        document.addEventListener("auxclick", rewriteEventTarget, true);
        rewriteTree();
        document.addEventListener("DOMContentLoaded", () => rewriteTree(), { once: true });
        new MutationObserver((records) => {
          for (const record of records) {
            if (record.type === "attributes" && record.target instanceof HTMLAnchorElement) rewriteAnchor(record.target);
            record.addedNodes.forEach((node) => {
              if (node instanceof HTMLAnchorElement) rewriteAnchor(node);
              else if (node instanceof Element) rewriteTree(node);
            });
          }
        }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ["href"] });
      })();
    </script>
    {indexable && canonical && <link rel="canonical" href={canonical} />}
    {indexable && canonical && <meta property="og:url" content={canonical} />}
    {indexable && absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}
    {indexable && absoluteSocialImage && <meta property="og:image:width" content="1200" />}
    {indexable && absoluteSocialImage && <meta property="og:image:height" content="630" />}
    {indexable && absoluteSocialImage && <meta property="og:image:alt" content={title} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Digi Tracks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content={indexable && absoluteSocialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {indexable && absoluteSocialImage && <meta name="twitter:image" content={absoluteSocialImage} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    {pageStyles && <style set:html={pageStyles} />}
    <title>{title}</title>
  </head>
  <body class={bodyClass} id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href={origin} aria-label={brandSuffix ? `Digi Tracks ${brandSuffix} home` : "Digi Tracks home"}>
          <BrandLockup onDark={headerOnDark} priority />
          {brandSuffix && <span class="brand__suffix">{brandSuffix}</span>}
        </a>
        {isPortal ? (
          <nav class="desktop-nav" aria-label="Primary navigation">
            <details class="nav-menu">
              <summary>Products</summary>
              <div class="nav-menu__panel">
                <div class="nav-menu__intro">
                  <p class="t-label">The portfolio</p>
                  <strong>Find the right system.</strong>
                  <p>Start with the flagship, the work or the operating boundary.</p>
                  <a href="https://digitracks.net/products/">Browse all products</a>
                </div>
                <div class="nav-menu__group">
                  <p class="t-label">Flagship & core</p>
                  {flagshipLinks.map((item) => <a href={item.href}><strong>{item.label}</strong><small>{item.note}</small></a>)}
                  <a href="https://digitracks.net/products/mindone/compare/">Compare MIND ONE editions</a>
                </div>
                <div class="nav-menu__group">
                  <p class="t-label">Procurement</p>
                  {procurementLinks.map((item) => <a href={item.href}>{item.label}</a>)}
                </div>
                <div class="nav-menu__group">
                  <p class="t-label">Developer & security</p>
                  {engineeringLinks.map((item) => <a href={item.href}><strong>{item.label}</strong><small>{item.note}</small></a>)}
                </div>
              </div>
            </details>
            <a href="/industries/">Industries</a>
            <a href="/solutions/">Solutions</a>
            <a href="/services/">Services</a>
            <details class="nav-menu nav-menu--compact nav-menu--resources">
              <summary>Resources</summary>
              <div class="nav-menu__panel nav-menu__panel--compact">
                {resourceGroups.map((group) => (
                  <div class="nav-menu__group">
                    <p class="t-label">{group.label}</p>
                    {group.links.map((item) => (
                      <a href={item.href} rel={item.external ? "noopener" : undefined}>
                        <strong>{item.label}{item.external && <span class="nav-menu__ext" aria-hidden="true">↗</span>}</strong>
                        <small>{item.note}</small>
                      </a>
                    ))}
                  </div>
                ))}
                <a class="nav-menu__cta" href="/resources/">All resources<span aria-hidden="true">→</span></a>
                <a class="nav-menu__cta" href="/products/mindone/compare/">Compare MIND ONE editions<span aria-hidden="true">→</span></a>
              </div>
            </details>
            <a href="/about/">About</a>
          </nav>
        ) : (
          <nav class="desktop-nav" aria-label="Primary navigation">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        )}
        <div class="site-header__actions">
          <details class="estate-switcher">
            <summary>Network</summary>
            <div class="estate-switcher__menu">
              {estateLinks.map((item) => <a href={item.href}>{item.label}</a>)}
            </div>
          </details>
          <a class="button button--primary button--small" href={requestHref} data-cta="request-demo">{requestLabel}</a>
        </div>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav class="mobile-nav__panel" aria-label="Mobile navigation">
            {isPortal ? (
              <>
                <p class="t-label">Flagship & core</p>
                {flagshipLinks.map((item) => <a href={item.href}><strong>{item.label}</strong><small>{item.note}</small></a>)}
                <a href="https://digitracks.net/products/mindone/compare/">Compare MIND ONE editions</a>
                <p class="t-label">Procurement</p>
                {procurementLinks.map((item) => <a href={item.href}>{item.label}</a>)}
                <p class="t-label">Developer & security</p>
                {engineeringLinks.map((item) => <a href={item.href}><strong>{item.label}</strong><small>{item.note}</small></a>)}
                <p class="t-label">Explore</p>
                <a href="https://digitracks.net/products/">All products</a>
                <a href="/industries/">Industries</a>
                <a href="/solutions/">Solutions</a>
                <a href="/services/">Services</a>
                <a href="/about/">About Digi Tracks</a>
                <p class="t-label">Resources</p>
                {resourceGroups.map((group) => (
                  <>
                    <p class="mobile-nav__sublabel">{group.label}</p>
                    {group.links.map((item) => (
                      <a href={item.href} rel={item.external ? "noopener" : undefined}>
                        <strong>{item.label}{item.external && <span class="nav-menu__ext" aria-hidden="true">↗</span>}</strong>
                        <small>{item.note}</small>
                      </a>
                    ))}
                  </>
                ))}
                <a href="/resources/">All resources</a>
              </>
            ) : (
              navItems.map((item) => <a href={item.href}>{item.label}</a>)
            )}
            <a class="button button--primary mobile-nav__request" href={requestHref}>{requestLabel}</a>
            <p class="t-label">Network</p>
            {estateLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="main" class={mainClass} tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__top">
        <div class="site-footer__intro">
          <a class="brand brand--inverse" href={origin} aria-label={brandSuffix ? `Digi Tracks ${brandSuffix} home` : "Digi Tracks home"}>
            <BrandLockup onDark={footerOnDark} />
            {brandSuffix && <span class="brand__suffix">{brandSuffix}</span>}
          </a>
          <h2 class="site-footer__claim">Focused software<br /><em>for specialised work.</em></h2>
          <a class="site-footer__cta" href={requestHref}>Discuss your workflow<span aria-hidden="true">→</span></a>
        </div>
        <div class="site-footer__col">
          <h2 class="t-label">Products</h2>
          <a href="https://digitracks.net/products/">All products</a>
          {flagshipLinks.filter((item) => !["Campus Grid", "Nipuna"].includes(item.label)).map((item) => <a href={item.href}>{item.label}</a>)}
          {engineeringLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="https://digitracks.net/procurement-software/">Procurement ecosystem</a>
        </div>
        <div class="site-footer__col">
          <h2 class="t-label">Explore</h2>
          {companyLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="site-footer__col">
          <h2 class="t-label">Learning</h2>
          {learningLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>
      <div class="shell site-footer__legal">
        <span>© 2026 Digi Tracks</span>
        <span>Network</span>
        {estateLinks.filter((item) => item.label !== "Portal").map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="https://digitracks.net/privacy/">Privacy</a>
        <a href="https://digitracks.net/terms/">Terms</a>
        <a href="https://digitracks.net/trust/">Trust</a>
        <a class="site-footer__top-link" href="#top">Back to top<span aria-hidden="true">↑</span></a>
      </div>
    </footer>
    <script>
      import { installAnalyticsBridge } from "../lib/analytics";
      installAnalyticsBridge();
    </script>
    <script>
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const openMenus = [...document.querySelectorAll<HTMLDetailsElement>(".site-header details[open]")];
        const menu = openMenus.at(-1);
        if (!menu) return;
        menu.open = false;
        menu.querySelector("summary")?.focus();
      });
      document.addEventListener("pointerdown", (event) => {
        if (!(event.target instanceof Element)) return;
        document.querySelectorAll<HTMLDetailsElement>(".site-header details[open]").forEach((menu) => {
          if (!menu.contains(event.target)) menu.open = false;
        });
      });
      document.querySelectorAll<HTMLDetailsElement>(".site-header details").forEach((menu) => {
        menu.addEventListener("toggle", () => {
          if (!menu.open) return;
          document.querySelectorAll<HTMLDetailsElement>(".site-header details[open]").forEach((other) => {
            if (other !== menu) other.open = false;
          });
        });
      });
    </script>
  </body>
</html>
