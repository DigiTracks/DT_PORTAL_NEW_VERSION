---
import type { HubRecord, PublicProductRecord } from "@digitracks/catalog";
import PageHero from "./PageHero.astro";
import Button from "./Button.astro";

interface Props {
  hub: HubRecord;
  products: readonly PublicProductRecord[];
  contactHref: string;
}

const { hub, products, contactHref } = Astro.props;
const tools = hub.toolIds
  .map((id) => products.find((item) => item.id === id))
  .filter((item): item is PublicProductRecord => Boolean(item));

const deployments = [...new Set(tools.map((tool) => tool.deployment))];
const platforms = [...new Set(tools.flatMap((tool) => [...tool.platforms]))];
const categories = [...new Set(tools.map((tool) => tool.category))];

const steps = [
  { title: "Shortlist by work", body: "Start from the job the team needs to do, not from the product name. Every tool below states the work it covers and the audience it is built for." },
  { title: "Check the deployment", body: "Each tool lists how it ships and what it runs on. Nothing in this hub assumes a hosted platform or a shared tenancy." },
  { title: "Connect or stay separate", body: "Tools in the same hub can exchange data where the workflow needs it. Where they cannot, the boundary is stated before the rollout rather than discovered after it." }
];
---

<PageHero
  id="page-title"
  title={hub.name}
  eyebrow={`Capability hub / ${tools.length} tools`}
  lede={hub.summary}
  compact
>
  <Button href="/products/">Browse the catalogue</Button>
  <Button href={contactHref} variant="secondary">Talk to the team</Button>
</PageHero>

<section class="hub-ledger" aria-label="Hub at a glance">
  <div class="shell hub-ledger__grid">
    <div><strong>{tools.length}</strong><span>Tools in this hub</span></div>
    <div><strong>{deployments.length}</strong><span>Deployment models</span></div>
    <div><strong>{categories.length}</strong><span>Work categories</span></div>
    <div><strong>{platforms.length}</strong><span>Supported platforms</span></div>
  </div>
</section>

<section class="hub-flow" aria-labelledby="hub-flow-title">
  <div class="shell">
    <div class="section-head">
      <div>
        <p class="t-label">How the hub is used</p>
        <h2 id="hub-flow-title">Three moves, then a decision.</h2>
      </div>
      <p>The same sequence every time, so a buyer can compare tools without reading four unrelated pitches.</p>
    </div>
    <ol class="hub-steps">
      {steps.map((step, index) => (
        <li>
          <span class="hub-steps__num">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="hub-register" aria-labelledby="hub-register-title">
  <div class="shell">
    <div class="section-head">
      <div>
        <p class="t-label">Tool register</p>
        <h2 id="hub-register-title">The working instruments.</h2>
      </div>
      <p>{tools.length} tools, each with its own licence, deployment and support terms. Open one to read the full capability map.</p>
    </div>
    <ul class="hub-cards">
      {tools.map((tool, index) => (
        <li>
          <a class="hub-card" href={`${tool.route}/`}>
            <span class="hub-card__index">{String(index + 1).padStart(2, "0")} / {tool.category}</span>
            <strong>{tool.name}<i aria-hidden="true">→</i></strong>
            <span class="hub-card__body">{tool.summary}</span>
            <span class="hub-card__meta">
              <span>{tool.deployment}</span>
              <span>{tool.platforms.join(" · ")}</span>
              <span>{tool.capabilities.length} capabilities</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="hub-deploy" aria-labelledby="hub-deploy-title">
  <div class="shell hub-deploy__inner">
    <div>
      <p class="t-label">Deployment</p>
      <h2 id="hub-deploy-title">Runs where the work runs.</h2>
      <p>No tool in this hub requires a hosted platform. Each one is licensed on its own and installed or deployed where your team already operates.</p>
    </div>
    <ul class="hub-deploy__list">
      {deployments.map((item) => (
        <li><span aria-hidden="true">→</span>{item}</li>
      ))}
      {platforms.map((item) => (
        <li><span aria-hidden="true">→</span>{item}</li>
      ))}
    </ul>
  </div>
</section>

<section class="hub-boundary" aria-labelledby="hub-boundary-title">
  <div class="shell hub-boundary__inner">
    <div>
      <p class="t-label">Scope boundary</p>
      <h2 id="hub-boundary-title">What this hub does not claim.</h2>
    </div>
    <ul>
      <li>The tools are not one platform. Each carries its own licence, release cycle and support route.</li>
      <li>Capabilities are listed as they ship today. Anything on a roadmap is named as such on the product page, never in the register.</li>
      <li>Data exchange between two tools is scoped per engagement, not assumed because they sit in the same hub.</li>
    </ul>
  </div>
</section>

<section class="hub-close">
  <div class="shell hub-close__inner">
    <div>
      <p class="t-label">Next step</p>
      <h2>Pick the tool, then scope the rollout.</h2>
      <p>Send the workflow that needs to change and the environment it runs in. The reply names the tool, the deployment model and the first milestone.</p>
    </div>
    <Button href={contactHref}>Start a conversation</Button>
  </div>
</section>

<style>
  .hub-ledger { background: var(--paper-bright); border-block: 1px solid rgb(13 27 46 / 12%); }
  .hub-ledger__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: rgb(13 27 46 / 12%); }
  .hub-ledger__grid > div { display: grid; gap: 0.3rem; padding: 1.15rem 1.25rem; background: var(--paper-bright); }
  .hub-ledger strong { font-family: var(--font-display); font-size: clamp(1.6rem, 2.4vw, 2.2rem); font-weight: 550; letter-spacing: -0.03em; color: var(--ink); line-height: 1; }
  .hub-ledger span { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: #6c7a8c; }

  .hub-flow { padding-block: clamp(2.8rem, 5vw, 4.6rem); }
  .hub-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 1.8rem 0 0; padding: 0; list-style: none; background: rgb(13 27 46 / 14%); }
  .hub-steps li { display: grid; gap: 0.55rem; align-content: start; padding: 1.6rem 1.5rem; background: var(--paper-bright); }
  .hub-steps__num { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.16em; color: #8a6114; }
  .hub-steps h3 { margin: 0; font-family: var(--font-display); font-size: 1.2rem; font-weight: 560; letter-spacing: -0.02em; color: var(--ink); }
  .hub-steps p { margin: 0; color: var(--ink-muted); font-size: 0.94rem; line-height: 1.6; }

  .hub-register { background: var(--paper); padding-block: clamp(2.8rem, 5vw, 4.6rem); border-block: 1px solid rgb(13 27 46 / 10%); }
  .hub-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 1.8rem 0 0; padding: 0; list-style: none; background: rgb(13 27 46 / 14%); }
  .hub-cards li { background: var(--paper-bright); }
  .hub-card { display: grid; gap: 0.6rem; height: 100%; padding: 1.6rem 1.5rem; color: inherit; text-decoration: none; transition: background 160ms ease; }
  .hub-card:hover { background: #fffdf6; }
  .hub-card__index { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: #8a6114; }
  .hub-card strong { display: flex; gap: 0.6rem; align-items: baseline; font-family: var(--font-display); font-size: clamp(1.3rem, 1.8vw, 1.6rem); font-weight: 560; letter-spacing: -0.025em; color: var(--ink); }
  .hub-card strong i { font-size: 1rem; font-style: normal; color: #7b8698; transition: transform 160ms ease, color 160ms ease; }
  .hub-card:hover strong i { transform: translateX(3px); color: #8a6114; }
  .hub-card__body { color: var(--ink-muted); font-size: 0.96rem; line-height: 1.6; }
  .hub-card__meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; margin-top: 0.3rem; padding-top: 0.8rem; border-top: 1px solid rgb(13 27 46 / 10%); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: #6c7a8c; }

  .hub-deploy { background: var(--night); color: var(--paper-bright); padding-block: clamp(2.8rem, 5vw, 4.6rem); }
  .hub-deploy__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .hub-deploy .t-label { color: var(--signal); }
  .hub-deploy h2 { margin: 0.5rem 0 0.9rem; font-family: var(--font-display); font-size: clamp(1.9rem, 3.2vw, 2.8rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; color: var(--paper-bright); }
  .hub-deploy p { max-width: 46ch; margin: 0; color: rgb(198 212 230 / 88%); line-height: 1.65; }
  .hub-deploy__list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(198 212 230 / 22%); }
  .hub-deploy__list li { display: flex; gap: 0.8rem; align-items: baseline; padding: 0.7rem 0; border-bottom: 1px solid rgb(198 212 230 / 16%); color: var(--steel); font-size: 0.95rem; }
  .hub-deploy__list span { color: var(--signal); font-family: var(--font-mono); font-size: 0.7rem; }

  .hub-boundary { padding-block: clamp(2.8rem, 5vw, 4.6rem); }
  .hub-boundary__inner { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .hub-boundary h2 { margin: 0.5rem 0 0; font-family: var(--font-display); font-size: clamp(1.7rem, 2.8vw, 2.3rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1.05; color: var(--ink); }
  .hub-boundary ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; border-top: 1px solid rgb(13 27 46 / 14%); }
  .hub-boundary li { padding: 0.9rem 0; border-bottom: 1px solid rgb(13 27 46 / 10%); color: var(--ink-muted); font-size: 0.96rem; line-height: 1.6; }

  .hub-close { background: var(--paper-bright); border-top: 1px solid rgb(13 27 46 / 12%); padding-block: clamp(2.8rem, 5vw, 4.6rem); }
  .hub-close__inner { display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-end; justify-content: space-between; }
  .hub-close h2 { margin: 0.5rem 0 0.8rem; font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.02; color: var(--ink); }
  .hub-close p { max-width: 52ch; margin: 0; color: var(--ink-muted); line-height: 1.6; }

  @media (max-width: 960px) {
    .hub-ledger__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hub-steps { grid-template-columns: 1fr; }
    .hub-cards { grid-template-columns: 1fr; }
    .hub-deploy__inner, .hub-boundary__inner { grid-template-columns: 1fr; }
  }
</style>
