---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "quiet";
  size?: "normal" | "small";
  ctaId?: string;
  external?: boolean;
}

const { href, variant = "primary", size = "normal", ctaId, external = false } = Astro.props;
const externalProps = external ? { target: "_blank", rel: "noreferrer" } : {};
---

<a class={`button button--${variant} button--${size}`} href={href} data-cta={ctaId} {...externalProps}>
  <slot />
  <svg class="button__arrow" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
