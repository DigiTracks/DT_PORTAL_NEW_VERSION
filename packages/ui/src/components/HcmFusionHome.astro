---
import Button from "./Button.astro";

interface Props {
  baselineCount: number;
  blockedCount: number;
}

const { baselineCount, blockedCount } = Astro.props;
const requestHref = "https://digitracks.net/contact/?intent=consultation&origin=hcmfusion";
const evidenceItems = [
  { path: "/sources/gaps/", label: "Evidence register", title: "What remains unknown.", copy: "Source ownership, application parity, assessment policy and migration permission are recorded as gaps, not guessed.", action: "Open gap register" },
  { path: "/sources/releases/", label: "Release method", title: "What a release claim must prove.", copy: "Read the evidence required before release notes, concept pages or assessment material can be approved.", action: "Open release method" },
  { path: requestHref, label: "Authorised access", title: "Keep tenant data separate.", copy: "Account access, protected assessment content and progress require an authenticated, tenant-aware service that is not configured here.", action: "Discuss authorised access" }
] as const;
const publicEvidenceCount = evidenceItems.filter((item) => item.path.startsWith("/")).length;
---

<section class="hcm-hero" aria-labelledby="hcm-title">
  <div class="shell hcm-hero__grid">
    <div class="hcm-hero__copy">
      <p class="t-label">HCM Fusion / evidence before exposure</p>
      <h1 id="hcm-title">People systems.<br><em>Carefully understood.</em></h1>
      <p class="hcm-hero__lede">A public home for HCM concepts, source verification and the limits of what can responsibly be republished.</p>
      <div class="button-row">
        <Button href="#hcm-evidence" ctaId="explore-hcm-evidence">Explore the evidence pages</Button>
        <Button href={requestHref} variant="secondary">Ask about authorised material</Button>
      </div>
    </div>
    <div class="hcm-monolith" aria-hidden="true">
      <div class="hcm-monolith__face hcm-monolith__face--back">HCM</div>
      <div class="hcm-monolith__face hcm-monolith__face--mid">FUSION</div>
      <div class="hcm-monolith__face hcm-monolith__face--front"><span>EVIDENCE<br>BOUNDARY</span><small>PUBLIC / VERIFIED SCOPE</small></div>
    </div>
  </div>
  <div class="shell hcm-hero__ledger">
    <div><strong>{String(baselineCount).padStart(3, "0")}</strong><span>baseline identifiers</span></div>
    <div><strong>{String(publicEvidenceCount).padStart(2, "0")}</strong><span>public evidence pages</span></div>
    <div><strong>{String(blockedCount).padStart(3, "0")}</strong><span>withheld from indexing</span></div>
  </div>
</section>

<section class="section hcm-evidence" id="hcm-evidence" aria-labelledby="hcm-evidence-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">What is public</p><h2 id="hcm-evidence-title">Verification you can inspect.</h2></div>
      <p>The build separates independently authored evidence pages from rights-reserved concept, certification and assessment material.</p>
    </div>
    <div class="hcm-evidence-grid">
      {evidenceItems.map((item, index) => (
        <a href={item.path}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p class="t-label">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
          <small>{item.action} ↗</small>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section--ruled hcm-boundary" aria-labelledby="hcm-boundary-title">
  <div class="shell hcm-boundary__grid">
    <div><p class="t-label">Protected material</p><h2 id="hcm-boundary-title">Preserved does not mean published.</h2></div>
    <div class="prose"><p>Historic HCM Fusion addresses remain reachable so links do not silently break. Rights-reserved content is withheld from search indexing and marked <code>noindex</code> until permission and editorial review are recorded.</p><p>No assessment answers, certification results, employee records, tenant data or learning progress are exposed in the public build.</p><Button href="/sources/gaps/" variant="secondary">See the open evidence gaps</Button></div>
  </div>
</section>
