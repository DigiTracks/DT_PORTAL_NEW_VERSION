---
import type { ProductRecord } from "@digitracks/catalog";
import Button from "./Button.astro";

interface Props {
  product: ProductRecord;
}

const { product } = Astro.props;
const isComplete = product.id === "mindone-pro";
const requestHref = `/contact/?intent=product-enquiry&product=${encodeURIComponent(product.id)}`;
const compareHref = "/products/mindone/compare/";
const requestLabel = isComplete ? "Request Complete access" : "Request Basic access";
const practiceSteps = [
  { number: "01", title: "Ground the session", label: "Résumé + role brief", copy: "Start with the candidate’s experience and the requirements of the role." },
  { number: "02", title: "Ask the question", label: "Role-specific practice", copy: "Use résumé- and job-description-grounded questions for the role being practised." },
  { number: "03", title: "Take the answer", label: "Speak or type", copy: "Practise with browser speech input or use the typed fallback." },
  { number: "04", title: "Coach the response", label: "Answer-specific guidance", copy: "Review coaching and model-answer rewriting against the answer given." },
  { number: "05", title: "Keep the debrief", label: "Priorities + drill sheet", copy: "Finish with prioritised tips and a focused practice sheet." }
] as const;
const unknowns = [
  ["Price and licence", "Final commercial terms for each edition require owner confirmation."],
  ["Usage limits", "Released quotas and session limits are not published. Provider and technical limits still apply."],
  ["Integrations", "No ATS, MCP or other integration has been verified."],
  ["Deployment and providers", "Production deployment, hosted AI providers and retention details require confirmation."],
  ["Release timing", "No approved public launch date is published."]
] as const;
---

<section class="flagship-hero" aria-labelledby="flagship-title">
  <div class="flagship-hero__word" aria-hidden="true">{isComplete ? "COMPLETE" : "M/01"}</div>
  <div class="shell flagship-hero__grid">
    <div class="flagship-hero__copy">
      <p class="t-label"><span class="signal-dot" aria-hidden="true"></span>MIND ONE family / {product.edition}</p>
      <h1 id="flagship-title"><span class={isComplete ? "flagship-hero__title--complete" : undefined}>{product.name}</span><em>{isComplete ? "The full MIND ONE experience." : "Your experience should shape the rehearsal."}</em></h1>
      <p class="flagship-hero__lede">{product.summary}. {isComplete ? "The implemented Complete scope adds durable local history, progress and role-development tools to the shared practice model." : "A free, focused pre-launch practice position for candidates preparing for competency-based interviews."}</p>
      <div class="button-row">
        <Button href={requestHref} ctaId="request-mindone-access">{requestLabel}</Button>
        <Button href={compareHref} variant="secondary" ctaId="compare-mindone-editions">Compare Basic and Complete</Button>
      </div>
      <p class="flagship-hero__request-note">Request only. An enquiry does not grant product access, activate billing or reserve a release date.</p>
      <dl class="flagship-hero__facts">
        <div><dt>Availability</dt><dd>{product.status}</dd></div>
        <div><dt>Evidence</dt><dd>{isComplete ? "Implemented Complete scope reviewed" : "Core practice scope reviewed"}</dd></div>
      </dl>
    </div>

    {isComplete ? (
      <figure class="edition-instrument">
        <div class="edition-instrument__head"><span>DT / MIND ONE—COMPLETE</span><span>Implemented scope</span></div>
        <div class="edition-instrument__body">
          <p class="t-label">Full feature position</p>
          <strong>COMPLETE</strong>
          <ol>
            {product.capabilities.map((capability, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{capability}</p></li>)}
          </ol>
        </div>
        <figcaption>Reviewed product model · not an application screenshot</figcaption>
      </figure>
    ) : (
      <figure class="practice-instrument">
        <div class="practice-instrument__head"><span>DT / MIND ONE—BASIC</span><span>Practice sequence</span></div>
        <div class="practice-instrument__source">
          <span>Input 01</span><strong>Candidate experience</strong><small>Résumé evidence</small>
          <i aria-hidden="true"></i>
          <span>Input 02</span><strong>Role requirements</strong><small>Job description</small>
        </div>
        <ol class="practice-instrument__sequence">
          {practiceSteps.map((step) => <li><span>{step.number}</span><div><strong>{step.title}</strong><small>{step.label}</small></div></li>)}
        </ol>
        <div class="practice-instrument__output"><span>Output</span><strong>Structured debrief</strong><small>Tips · readouts · drill sheet</small></div>
        <figcaption>Reviewed product model · not an application screenshot</figcaption>
      </figure>
    )}
  </div>
  <div class="shell flagship-hero__foot"><span>Education</span><span>Recruitment</span><span>Interview practice</span><span>Pre-launch / request only</span></div>
</section>

<section class="flagship-brief section" aria-labelledby="flagship-brief-title">
  <div class="shell flagship-brief__grid">
    <div><p class="t-label">The MIND ONE family</p><h2 id="flagship-brief-title">{isComplete ? "One practice model. A complete workspace." : "Practice should begin with what you have actually done."}</h2></div>
    <div class="prose">
      <p>{isComplete ? "MIND ONE Complete carries the shared résumé- and role-grounded practice model into a fuller local workspace. Its implemented scope includes durable profiles and history, résumé/JD comparison, learning goals, progress tracking, role-development maps, source-attributed opportunity research, app lock and diagnostics." : "Generic interview questions cannot show how a candidate’s experience meets a role’s demands. MIND ONE Basic connects the résumé and job description to practice questions, then uses the answer itself to shape coaching and debrief."}</p>
      <p><strong>Who it is for.</strong> {product.audience}.</p>
      <p>{isComplete ? "Full feature access does not mean unmetered hosted AI. It does not establish released billing, licence activation or a public launch date." : "The intended outcome is focused preparation—not a guaranteed score, job offer or assessment result. No measured outcome has been published."}</p>
    </div>
  </div>
</section>

<section class="flagship-sequence section" aria-labelledby="flagship-sequence-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">The shared practice sequence</p><h2 id="flagship-sequence-title">From evidence to a better rehearsal.</h2></div>
      <p>A five-part product model showing the intended flow. It is not a captured screen and does not demonstrate a released build.</p>
    </div>
    <ol class="sequence-register">
      {practiceSteps.map((step) => <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.copy}</p><small>{step.label}</small></div></li>)}
    </ol>
  </div>
</section>

<section class="flagship-scope section" aria-labelledby="flagship-scope-title">
  <div class="shell flagship-scope__grid">
    <div>
      <p class="t-label">{isComplete ? "Complete scope" : "Basic scope"}</p>
      <h2 id="flagship-scope-title">{isComplete ? "The complete workspace." : "Focused practice. Clear boundaries."}</h2>
      <ul class="index-list index-list--simple">
        {product.capabilities.map((capability) => <li><strong>{capability}</strong></li>)}
      </ul>
    </div>
    <aside class="privacy-note">
      <p class="t-label">Data posture</p>
      <h3>{isComplete ? "Local history. Explicit choices." : "Local by default. Hosted only by choice."}</h3>
      <p>{isComplete ? "Complete adds durable local profiles and practice history. Hosted AI remains an explicit configuration choice; provider, retention, quota and production details still require confirmation." : "The published scope describes focused in-memory sessions. Optional hosted AI requires explicit consent. Provider, retention and production configuration details still require confirmation."}</p>
      <Button href={requestHref} variant="secondary" ctaId="request-mindone-access">Ask about data handling</Button>
    </aside>
  </div>
</section>

<section class="flagship-unknowns section" aria-labelledby="flagship-unknowns-title">
  <div class="shell flagship-unknowns__grid">
    <div class="section-head section-head--inverse">
      <div><p class="t-label">Commercial and deployment boundary</p><h2 id="flagship-unknowns-title">What still needs confirmation.</h2></div>
      <p>Implemented capability and released commercial entitlement are different questions.</p>
    </div>
    <dl class="unknown-register">
      {unknowns.map(([term, detail]) => <div><dt>{term}</dt><dd><span>UNKNOWN</span>{detail}</dd></div>)}
    </dl>
  </div>
</section>

<section class="flagship-editions section" aria-labelledby="flagship-editions-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">Choose your edition</p><h2 id="flagship-editions-title">One family.<br>Two ways to practise.</h2></div>
      <p>Basic is the free, focused position. Complete provides full MIND ONE feature access. Both remain request-only during pre-launch.</p>
    </div>
    <div class="flagship-editions__grid">
      <a class="edition-card edition-card--entry" href="/products/mindone/">
        <span class="t-label">Free / focused practice</span><h3>MIND ONE Basic</h3><p>Grounded questions, spoken or typed answers, answer-specific coaching and a structured debrief.</p><small>Explore Basic <span aria-hidden="true">↗</span></small>
      </a>
      <a class="edition-card edition-card--complete" href="/products/mindone-pro/">
        <span class="t-label">Full feature access</span><h3>MIND ONE Complete</h3><p>The complete practice workspace with durable history, progress, comparison and role-development tools.</p><small>Explore Complete <span aria-hidden="true">↗</span></small>
      </a>
    </div>
  </div>
</section>

<section class="flagship-evidence section" aria-labelledby="flagship-evidence-title">
  <div class="shell flagship-evidence__grid">
    <p class="t-label">Evidence boundary</p>
    <div><h2 id="flagship-evidence-title">What this page cannot prove.</h2><p>{product.evidenceNote}</p></div>
    <nav aria-label="Related industry paths"><a href="/solutions/education/">Education & Academics <span aria-hidden="true">↗</span></a><a href="/solutions/recruitment/">Recruitment <span aria-hidden="true">↗</span></a></nav>
  </div>
</section>

<section class="flagship-close" aria-labelledby="flagship-close-title">
  <div class="shell flagship-close__grid">
    <div><p class="t-label">Qualified interest</p><h2 id="flagship-close-title">{isComplete ? "Evaluate the complete MIND ONE workspace." : "Bring the role you are preparing for."}</h2></div>
    <div><p>Tell us which edition you are evaluating and which requirements matter most. We will confirm current scope and access rather than imply that a demo or licence has already been granted.</p><Button href={requestHref} ctaId="request-mindone-access">{requestLabel}</Button></div>
  </div>
</section>
