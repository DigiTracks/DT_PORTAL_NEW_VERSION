---
import Button from "./Button.astro";
import type { RouteRecord } from "@digitracks/seo";

interface Props {
  route: RouteRecord;
}

interface PlatformEntry {
  key: string;
  name: string;
  label: string;
  href: string;
  lede: string;
  facts: string[];
  links: { label: string; href: string; note: string }[];
}

const platforms: Record<string, PlatformEntry> = {
  "/sourcecraft/": {
    key: "sourcecraft",
    name: "SourceCraft",
    label: "Contract language",
    href: "https://sourcecraft.digitracks.net/",
    lede: "Procurement and contract language explained plainly, with the same term read across regions.",
    facts: ["Free to open", "No account", "Reference in the browser"],
    links: [
      { label: "Browse the reference", href: "https://sourcecraft.digitracks.net/explore/", note: "Terms, clauses and the comparisons behind them." },
      { label: "Compare terms", href: "https://sourcecraft.digitracks.net/compare/", note: "Put two terms side by side before you use either." },
      { label: "Regional notes", href: "https://sourcecraft.digitracks.net/regions/", note: "India, the United States, the United Kingdom and California." }
    ]
  },
  "/learnpmo/": {
    key: "learnpmo",
    name: "LearnPMO",
    label: "Project delivery",
    href: "https://learnpmo.digitracks.net/",
    lede: "Project, programme and portfolio delivery taught through lessons, mock exams and practice by industry.",
    facts: ["Free to open", "No account", "Progress kept in the browser"],
    links: [
      { label: "Lessons", href: "https://learnpmo.digitracks.net/lessons", note: "The academy sequence, from charter to closure." },
      { label: "Mock exams", href: "https://learnpmo.digitracks.net/exams", note: "Sit a paper and see the reasoning behind each answer." },
      { label: "Industries practice", href: "https://learnpmo.digitracks.net/industries", note: "Apply the method to a sector's own delivery model." },
      { label: "Document templates", href: "https://learnpmo.digitracks.net/documents", note: "Charters, registers and logs you can take into the work." }
    ]
  },
  "/procuresherpa/": {
    key: "procuresherpa",
    name: "ProcureSherpa Learning",
    label: "Procurement",
    href: "https://procuresherpa.digitracks.net/",
    lede: "Academy modules, calculators, SOPs and templates for sourcing, contracts and spend.",
    facts: ["Free to open", "No account", "Saved work stays on the device"],
    links: [
      { label: "Open the academy", href: "https://procuresherpa.digitracks.net/", note: "Modules, calculators, the reference library and scenario practice." }
    ]
  },
  "/hcmfusion/": {
    key: "hcmfusion",
    name: "HCM Fusion",
    label: "People operations",
    href: "https://hcmfusion.digitracks.net/",
    lede: "Oracle Fusion Cloud HCM taught in configuration order: Core HR, absence, time, payroll, recruiting and talent.",
    facts: ["Free to open", "No account", "Practice labs in the browser"],
    links: [
      { label: "Learning paths", href: "https://hcmfusion.digitracks.net/learn/paths", note: "The order to configure in, and why it matters." },
      { label: "Courses", href: "https://hcmfusion.digitracks.net/learn/courses", note: "Every lesson, grouped by module." },
      { label: "Concepts", href: "https://hcmfusion.digitracks.net/concepts", note: "The structures the rest of the configuration hangs from." },
      { label: "Glossary", href: "https://hcmfusion.digitracks.net/glossary", note: "Terms as the product uses them, not as a textbook does." },
      { label: "Source registry", href: "https://hcmfusion.digitracks.net/sources", note: "Where each claim in the material comes from." }
    ]
  }
};

const { route } = Astro.props;
const platform = platforms[route.path];
const others = Object.entries(platforms).filter(([path]) => path !== route.path);

if (!platform) throw new Error(`No launch entry for ${route.path}`);
---

<section class="ll-hero" aria-labelledby="ll-title">
  <div class="shell ll-hero__grid">
    <div class="ll-hero__copy">
      <p class="t-label"><span class="signal-dot" aria-hidden="true"></span>Digi Tracks learning / {platform.label}</p>
      <h1 id="ll-title">Open {platform.name}.<br><em>Start with the first page.</em></h1>
      <p class="ll-hero__lede">{platform.lede}</p>
      <div class="button-row">
        <Button href={platform.href} external ctaId="open-live-platform">Open {platform.name}</Button>
        <Button href="/" variant="secondary" ctaId="all-platforms">All four platforms</Button>
      </div>
      <ul class="ll-facts">{platform.facts.map((fact) => <li>{fact}</li>)}</ul>
    </div>
    <div class="ll-address">
      <p class="t-label">Direct address</p>
      <a href={platform.href} rel="noreferrer" target="_blank">{platform.href.replace("https://", "").replace(/\/$/, "")}<span aria-hidden="true">↗</span></a>
      <p>The link goes straight into the live platform. Nothing is sent, stored or approved on the way.</p>
    </div>
  </div>
</section>

<section class="ll-inside section" aria-labelledby="ll-inside-title">
  <div class="shell">
    <div class="ll-inside__head">
      <div><p class="t-label">Straight in</p><h2 id="ll-inside-title">Inside {platform.name}.</h2></div>
      <p>Each link below opens the live platform at that page. Nothing here is a preview or a sample.</p>
    </div>
    <ol class="ll-links">
      {platform.links.map((link, index) => (
        <li>
          <a href={link.href} rel="noreferrer" target="_blank">
            <span class="ll-links__index">{String(index + 1).padStart(2, "0")}</span>
            <span class="ll-links__body"><strong>{link.label}</strong><small>{link.note}</small></span>
            <span class="ll-links__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="ll-boundary section" aria-labelledby="ll-boundary-title">
  <div class="shell ll-boundary__grid">
    <div><p class="t-label">Access</p><h2 id="ll-boundary-title">Free, open, no request.</h2></div>
    <div class="ll-boundary__body">
      <p>Every published page in {platform.name} is open to anyone with the link. There is no approval step, no trial key and no account to ask for.</p>
      <p>Work you save — progress, notes, calculations — is kept in this browser on this device. Nothing is uploaded, and clearing site data clears the work.</p>
      <Button href={platform.href} external ctaId="open-live-platform">Open {platform.name}<span aria-hidden="true"> ↗</span></Button>
    </div>
  </div>
</section>

<section class="ll-others section" aria-labelledby="ll-others-title">
  <div class="shell">
    <div class="ll-others__head"><p class="t-label">The other three</p><h2 id="ll-others-title">Same door, different work.</h2></div>
    <ul class="ll-others__list">
      {others.map(([path, entry]) => (
        <li>
          <a href={entry.href} rel="noreferrer" target="_blank">
            <span class="t-label">{entry.label}</span>
            <strong>{entry.name}</strong>
            <span class="ll-others__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ll-hero { padding-block: 4.5rem 3.5rem; background: var(--night); color: var(--paper-bright); }
  .ll-hero__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
  .ll-hero .t-label { color: var(--steel); }
  .ll-hero h1 { margin: 0.9rem 0 0; font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 4.6rem); line-height: 0.94; letter-spacing: -0.035em; font-weight: 500; }
  .ll-hero h1 em { display: block; font-family: var(--font-editorial); font-style: italic; font-weight: 400; color: var(--signal); letter-spacing: -0.01em; }
  .ll-hero__lede { margin-top: 1.4rem; max-width: 40ch; font-size: 1.02rem; line-height: 1.55; color: var(--steel); }
  .ll-facts { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  .ll-facts li { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .ll-facts li::before { content: "•"; margin-right: 0.5rem; color: var(--signal); }
  .ll-hero .button-row { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .ll-hero :global(.button--primary) { background: var(--signal); border-color: var(--signal); color: var(--night); }
  .ll-hero :global(.button--primary:hover) { background: var(--paper-bright); border-color: var(--paper-bright); color: var(--night); }
  .ll-hero :global(.button--secondary) { color: var(--paper-bright); border-color: rgb(198 212 230 / 42%); }
  .ll-hero :global(.button--secondary:hover) { color: var(--night); background: var(--paper-bright); border-color: var(--paper-bright); }
  .ll-address { padding: 1.4rem; border: 1px solid rgb(198 212 230 / 24%); }
  .ll-address .t-label { color: var(--steel); }
  .ll-address a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.6rem; font-family: var(--font-mono); font-size: 0.82rem; color: var(--paper-bright); text-decoration: none; border-bottom: 1px solid rgb(198 212 230 / 30%); padding-bottom: 0.7rem; }
  .ll-address a:hover { color: var(--signal); border-color: var(--signal); }
  .ll-address p:last-child { margin: 0.8rem 0 0; font-size: 0.86rem; line-height: 1.5; color: var(--steel); }

  .ll-inside__head { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; align-items: end; margin-bottom: 2.4rem; }
  .ll-inside__head h2 { margin: 0.5rem 0 0; font-family: var(--font-display); font-size: clamp(2rem, 3.4vw, 3.2rem); line-height: 1; letter-spacing: -0.03em; font-weight: 500; }
  .ll-inside__head > p { margin: 0; max-width: 34ch; font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); }
  .ll-links { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(13 27 46 / 14%); }
  .ll-links li { border-bottom: 1px solid rgb(13 27 46 / 14%); }
  .ll-links a { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr) 1.6rem; gap: 0.8rem; align-items: center; padding: 1.2rem 0.2rem; text-decoration: none; color: var(--ink); }
  .ll-links a:hover strong { color: var(--signal-deep, #8a6114); }
  .ll-links__index { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--ink-muted); }
  .ll-links__body { display: flex; flex-direction: column; gap: 0.2rem; }
  .ll-links__body strong { font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; letter-spacing: -0.01em; }
  .ll-links__body small { font-size: 0.88rem; line-height: 1.5; color: var(--ink-muted); }
  .ll-links__arrow { justify-self: end; color: var(--ink-muted); }

  .ll-boundary { background: var(--paper); }
  .ll-boundary__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem; }
  .ll-boundary__grid h2 { margin: 0.5rem 0 0; font-family: var(--font-display); font-size: clamp(1.9rem, 3vw, 2.8rem); line-height: 1; letter-spacing: -0.03em; font-weight: 500; max-width: 12ch; }
  .ll-boundary__body p { margin: 0 0 0.9rem; max-width: 46ch; font-size: 0.95rem; line-height: 1.65; color: var(--ink); }
  .ll-boundary__body .button { margin-top: 0.6rem; }

  .ll-others__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; border-top: 1px solid rgb(13 27 46 / 14%); padding-top: 1.4rem; }
  .ll-others__head h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 2vw, 1.8rem); font-weight: 500; letter-spacing: -0.02em; }
  .ll-others__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  .ll-others__list a { display: grid; grid-template-columns: minmax(0, 1fr) 1rem; gap: 0.4rem 0.8rem; padding: 1.2rem; border: 1px solid rgb(13 27 46 / 14%); text-decoration: none; color: var(--ink); height: 100%; }
  .ll-others__list a:hover { border-color: var(--ink); }
  .ll-others__list strong { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; grid-column: 1; }
  .ll-others__arrow { grid-column: 2; grid-row: 1 / span 2; justify-self: end; align-self: center; color: var(--ink-muted); }

  @media (max-width: 64rem) {
    .ll-hero__grid, .ll-inside__head, .ll-boundary__grid { grid-template-columns: minmax(0, 1fr); }
    .ll-others__list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 38.75rem) {
    .ll-hero { padding-block: 3rem 2.5rem; }
    .ll-links a { grid-template-columns: 2rem minmax(0, 1fr) 1.2rem; padding: 1rem 0; }
  }
</style>
