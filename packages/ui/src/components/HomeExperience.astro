---
import { productRegistry, solutionRegistry, type ProductRecord } from "@digitracks/catalog";
import { routeRegistry } from "@digitracks/seo";
import Button from "./Button.astro";
import EcosystemSculpture from "./EcosystemSculpture.tsx";
import Icon from "./Icon";
import ProductAtlas from "./ProductAtlas.tsx";
import ProductMark from "./ProductMark";

interface Props {
  contactHref: string;
}

const { contactHref } = Astro.props;
const products = productRegistry;
const catalogueCount = products.length;
const requestOnlyCount = products.filter((product) => product.availability === "request-only").length;
const publicOriginCount = new Set(routeRegistry.map((route) => route.origin)).size;
const mindone = products.find((product) => product.id === "mindone")!;
const mindonePro = products.find((product) => product.id === "mindone-pro")!;
const heroProductIds = ["mindone", "mindone-pro", "vedik", "nipuna", "vertex", "vantor"];
const heroProducts = heroProductIds
  .map((id) => products.find((product) => product.id === id))
  .filter((product): product is ProductRecord => Boolean(product));
const elevatedProducts = [
  {
    product: products.find((product) => product.id === "vedik")!,
    number: "01",
    headline: "Run the institution.",
    copy: "Role-based school operations across learners, academics, fees and administration—shown in a public demo with sample data, with production deployment still to evaluate.",
    cta: "Request a Vedik demo",
    intent: "demo",
    ctaId: "request-product-demo"
  },
  {
    product: products.find((product) => product.id === "nipuna")!,
    number: "02",
    headline: "Review the candidate.",
    copy: "Local résumé intake, OCR and deterministic candidate matching for hiring teams that need a clear, reviewable pipeline rather than an opaque generative score.",
    cta: "Request a deployment assessment",
    intent: "consultation",
    ctaId: "request-product-consultation"
  }
] as const;
const procurementRoles: Record<string, string> = {
  vertex: "Operate",
  vantor: "Control",
  procure5: "Verify",
  sherpa: "Learn"
};
const procurementProductIds = ["vertex", "vantor", "procure5", "sherpa"];
const procurementProducts = procurementProductIds
  .map((id) => products.find((product) => product.id === id))
  .filter((product): product is ProductRecord => Boolean(product));
const practiceSteps = [
  ["01", "Ground", "Résumé + role brief"],
  ["02", "Respond", "Speak or type"],
  ["03", "Coach", "Answer-specific guidance"],
  ["04", "Debrief", "Priorities + drill sheet"]
] as const;
const serviceEngagements = [
  ["01", "Product evaluation", "Map the workflow, evidence and deployment questions before choosing a system.", "consultation", "Scope an evaluation"],
  ["02", "Implementation", "Define configuration, roles, data, acceptance and rollout responsibilities.", "consultation", "Discuss implementation"],
  ["03", "Migration", "Assess source data, transformation, reconciliation and cutover risk.", "migration", "Assess a migration"],
  ["04", "Support", "Triage the product, environment, impact and reproducible evidence.", "support", "Request support scoping"]
] as const;
const solutionIcons = {
  education: "education",
  healthcare: "health",
  "beauty-wellness": "sparkle",
  "business-operations": "building",
  procurement: "flow",
  recruitment: "users"
} as const;
const learningOrigins = [
  { number: "01", name: "Learn", href: "https://learn.digitracks.net/", copy: "A clear entry point into procurement learning and decision support.", meta: "Learning hub", icon: "book" },
  { number: "02", name: "Source Craft", href: "https://sourcecraft.digitracks.net/", copy: "Procurement language, terms and regional reference.", meta: "Reference library", icon: "library" },
  { number: "03", name: "LearnPMO", href: "https://learnpmo.digitracks.net/", copy: "Project and programme management learning routes.", meta: "Practice library", icon: "folder" },
  { number: "04", name: "HCM Fusion", href: "https://hcmfusion.digitracks.net/", copy: "Human-capital concepts, evidence and learning paths.", meta: "HCM library", icon: "users" },
  { number: "05", name: "ProcureSherpa Learning", href: "https://learn.digitracks.net/procuresherpa/", copy: "Academy modules, calculators, reference material and local saved work.", meta: "Academy component", icon: "flow" }
] as const;
---

<section class="hero hero--home" data-enter aria-labelledby="home-title">
  <div class="hero-home__grid shell">
    <div class="hero-home__copy">
      <p class="t-label hero-home__eyebrow"><span class="signal-dot" aria-hidden="true"></span>Digi Tracks / Product-led technology</p>
      <h1 id="home-title">Complex work.<br><em>Clear systems.</em></h1>
      <p class="hero-home__lede">MIND ONE grounds interview practice in the candidate’s own experience. Across education, recruitment and procurement, our products turn specialised work into clearer operating systems.</p>
      <div class="button-row">
        <Button href="/products/mindone/" ctaId="explore-mindone">Explore MIND ONE</Button>
        <Button href={contactHref} variant="secondary" ctaId="request-demo">Start a conversation</Button>
      </div>
    </div>
    <div class="hero-home__visual">
      <div class="hero-home__instrument-label" aria-hidden="true"><span>DT—01</span><span>Systems engine</span><span>Exploded architecture</span></div>
      <EcosystemSculpture client:media="(min-width: 721px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)" />
      <div class="hero-home__signals" aria-label="Featured Digi Tracks products">
        {heroProducts.map((product, index) => (
          <a class={`hero-home__signal hero-home__signal--${index + 1}`} href={`${product.route}/`}>
            <ProductMark product={product} size={34} />
            <span><small>{product.id === "mindone-pro" ? "Planned edition" : product.category}</small><strong>{product.name}</strong></span>
          </a>
        ))}
      </div>
      <div class="hero-home__coordinates" aria-hidden="true"><span>{String(publicOriginCount).padStart(2, "0")} origins</span><span>{String(catalogueCount).padStart(2, "0")} catalogue entries</span><span>{String(requestOnlyCount).padStart(2, "0")} request-only</span></div>
    </div>
  </div>
  <div class="hero-home__foot shell">
    <span>Scroll to enter the portfolio</span>
    <span>Full product access is qualified and issued separately.</span>
  </div>
</section>

<section class="home-flagship section" aria-labelledby="home-flagship-title">
  <div class="shell home-flagship__grid">
    <div class="home-flagship__copy">
      <p class="t-label">01 / The flagship</p>
      <h2 id="home-flagship-title">MIND ONE.<br><em>Practice with context.</em></h2>
      <p>Interview practice grounded in the candidate’s résumé and the role brief. The published model moves from a spoken or typed answer to answer-specific coaching, a prioritised debrief and a focused drill sheet.</p>
      <dl class="home-flagship__facts">
        <div><dt>Published scope</dt><dd>Candidate-led practice</dd></div>
        <div><dt>Availability</dt><dd>Pre-launch / request only</dd></div>
      </dl>
      <div class="button-row">
        <Button href="/contact/?intent=product-enquiry&product=mindone" ctaId="request-mindone-access">Request MIND ONE access</Button>
        <Button href="/products/mindone/compare/" variant="secondary" ctaId="compare-mindone-editions">Compare editions</Button>
      </div>
      <p class="home-flagship__note">An enquiry does not grant product access or reserve a release date.</p>
    </div>
    <figure class="mindone-sequence" aria-label="Published MIND ONE practice model, not an application screenshot">
      <div class="mindone-sequence__head"><span>MIND ONE / Practice model</span><span>Request only</span></div>
      <ol>
        {practiceSteps.map(([number, title, detail]) => <li><span>{number}</span><div><strong>{title}</strong><small>{detail}</small></div><i aria-hidden="true"></i></li>)}
      </ol>
      <figcaption><span>Résumé-grounded</span><span>Answer-specific</span><span>Local-only default</span></figcaption>
    </figure>
  </div>
  <div class="shell home-flagship__editions">
    <div class="home-flagship__editions-head"><p class="t-label">Two published positions</p><p>Editions are distinguished without inventing entitlements, price or release timing.</p></div>
    <div class="home-flagship__edition-grid">
      <article>
        <div class="home-flagship__edition-mark"><ProductMark product={mindone} size={48} /><span>Entry edition</span></div>
        <h3>MIND ONE</h3>
        <p>The published interview-practice scope: grounded questions, spoken or typed answers, coaching and debrief.</p>
        <a class="text-link" href="/products/mindone/">Inspect MIND ONE<span aria-hidden="true">↗</span></a>
      </article>
      <article>
        <div class="home-flagship__edition-mark"><ProductMark product={mindonePro} size={48} /><span>Planned complete edition</span></div>
        <h3>MIND ONE Pro</h3>
        <p>Complete-edition positioning is published. Pro-only features, quotas, integrations, price and timing require confirmation.</p>
        <a class="text-link" href="/products/mindone-pro/">Inspect MIND ONE Pro<span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </div>
</section>

<section class="home-duo section" aria-labelledby="home-duo-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">02 / Core products</p><h2 id="home-duo-title">Institutions and hiring teams.<br><em>Different systems.</em></h2></div>
      <p>Vedik organises education operations. Nipuna supports local-first recruiting. Each has its own users, evidence and deployment boundary.</p>
    </div>
    <div class="home-duo__grid">
      {elevatedProducts.map(({ product, number, headline, copy, cta, intent, ctaId }) => (
        <article class="duo-product">
          <header>
            <span>{number}</span>
            <ProductMark product={product} size={52} />
            <p class="t-label">{product.category} / {product.status}</p>
          </header>
          <h3>{headline}</h3>
          <p class="duo-product__name">{product.name}</p>
          <p>{copy}</p>
          <ol class="duo-product__map" aria-label={`${product.name} selected capabilities`}>
            {product.capabilities.slice(0, 4).map((capability, index) => <li key={capability}><span>{String(index + 1).padStart(2, "0")}</span><strong>{capability}</strong></li>)}
          </ol>
          <p class="duo-product__evidence"><strong>Evidence boundary.</strong> {product.evidenceNote}</p>
          <Button href={`/contact/?intent=${intent}&product=${product.id}`} variant="secondary" ctaId={ctaId}>{cta}</Button>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="home-procurement section" aria-labelledby="home-procurement-title">
  <div class="shell">
    <div class="home-procurement__head">
      <div><p class="t-label">03 / Procurement</p><h2 id="home-procurement-title">Different jobs.<br><em>Deliberate tools.</em></h2></div>
      <div><p>Operate projects and purchasing, control a self-hosted environment, verify procurement integrity or build practical capability. The category connects the conversation—not a shared data layer.</p><Button href="/procurement-software/" variant="secondary" ctaId="explore-procurement">Explore the procurement ecosystem</Button></div>
    </div>
    <ol class="home-procurement__grid">
      {procurementProducts.map((product, index) => (
        <li>
          <a href={`${product.route}/`}>
            <div class="home-procurement__card-head"><span>{String(index + 1).padStart(2, "0")}</span><ProductMark product={product} size={46} /></div>
            <p class="t-label">{procurementRoles[product.id]}</p>
            <h3>{product.name}</h3>
            <p>{product.summary}</p>
            <small>{product.status}</small>
            <i aria-hidden="true">↗</i>
          </a>
        </li>
      ))}
    </ol>
    <div class="home-procurement__learning">
      <div><p class="t-label">ProcureSherpa Learning</p><h3>Learn the work. Then use the tool.</h3></div>
      <p>Academy modules, calculators, reference material and local saved work—presented as the Academy component, not a separately verified SKU.</p>
      <a class="text-link" href="https://learn.digitracks.net/procuresherpa/">Open ProcureSherpa Learning<span aria-hidden="true">↗</span></a>
    </div>
    <p class="home-procurement__boundary">No first-party DigiTracks procurement MCP server, named ERP connector, automatic synchronisation or cross-product integration is implied.</p>
  </div>
</section>

<section class="atlas-section section" aria-labelledby="atlas-title">
  <div class="shell">
    <div class="section-head section-head--inverse">
      <div><p class="t-label">04 / The product atlas</p><h2 id="atlas-title">The wider<br><em>catalogue.</em></h2></div>
      <p>{catalogueCount} catalogue entries across enterprise operations, procurement, education, people, engineering and field operations. Choose a discipline, then inspect the record and its access boundary.</p>
    </div>
    <ProductAtlas products={products} client:visible />
  </div>
</section>

<section class="applications-section section" aria-labelledby="applications-title">
  <div class="shell applications-section__grid">
    <div class="applications-section__intro">
      <p class="t-label">05 / Industry paths</p>
      <h2 id="applications-title">Different work.<br>The same <em>clarity.</em></h2>
      <p>Start with the operational reality—not a category label. These paths connect a real workflow to the products built around it.</p>
      <a class="text-link" href="/industries/">View every industry path<span aria-hidden="true">↗</span></a>
    </div>
    <ol class="application-index">
      {solutionRegistry.map((solution, index) => (
        <li>
          <a href={`/solutions/${solution.id}/`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span class="application-index__icon"><Icon name={solutionIcons[solution.id as keyof typeof solutionIcons] ?? "layers"} size={23} weight="duotone" /></span>
            <strong>{solution.name}</strong>
            <p>{solution.summary}</p>
            <i aria-hidden="true">↗</i>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="engineering-section section" aria-labelledby="engineering-title">
  <div class="shell engineering-section__grid">
    <div class="engineering-section__copy">
      <p class="t-label">06 / Enterprise technology</p>
      <h2 id="engineering-title">Control the runtime.<br><em>Know the boundary.</em></h2>
      <p>Selected Digi Tracks products run on infrastructure you control. Their deployment models differ, so the boundary is stated per product—not stretched into one universal promise.</p>
      <a class="text-link" href="/services/">Review implementation services<span aria-hidden="true">↗</span></a>
    </div>
    <div class="deployment-schema" aria-label="Examples of product deployment boundaries">
      <div class="deployment-schema__head"><span>Deployment register</span><span>Selected systems</span></div>
      <div class="deployment-schema__diagram" aria-hidden="true"><span>Your environment</span><i></i><span>Product runtime</span><i></i><span>Your data</span></div>
      <dl>
        <div><dt>Nipuna</dt><dd>Windows desktop installer</dd></div>
        <div><dt>Vertex</dt><dd>Windows desktop installer</dd></div>
        <div><dt>Orion Hunter</dt><dd>Self-hosted infrastructure</dd></div>
      </dl>
      <p>Deployment is confirmed during evaluation.</p>
    </div>
  </div>
</section>

<section class="home-services section" aria-labelledby="home-services-title">
  <div class="shell home-services__grid">
    <div class="home-services__intro">
      <p class="t-label">07 / Services</p>
      <h2 id="home-services-title">Evidence before<br><em>commitment.</em></h2>
      <p>Evaluation, implementation, migration and support are distinct engagements. Start with the operating constraint and agree the evidence, ownership and scope before delivery claims.</p>
      <a class="text-link" href="/services/">Explore every engagement path<span aria-hidden="true">↗</span></a>
    </div>
    <ol class="home-services__list">
      {serviceEngagements.map(([number, title, summary, intent, cta]) => <li><span>{number}</span><div><h3>{title}</h3><p>{summary}</p></div><a href={`/contact/?intent=${intent}`} data-cta="request-conversation">{cta}<span aria-hidden="true">↗</span></a></li>)}
    </ol>
  </div>
</section>

<section class="learning-section section" aria-labelledby="learning-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">08 / Resources</p><h2 id="learning-title">Knowledge with<br>somewhere to go.</h2></div>
      <p>Public learning and reference origins, each with its own purpose and state boundary.</p>
    </div>
    <ol class="origin-index">
      {learningOrigins.map((origin) => <li><a href={origin.href}><span>{origin.number}</span><span class="origin-index__icon"><Icon name={origin.icon} size={23} weight="duotone" /></span><strong>{origin.name}</strong><p>{origin.copy}</p><small>{origin.meta}</small><i aria-hidden="true">↗</i></a></li>)}
    </ol>
  </div>
</section>

<section class="studio-section section" aria-labelledby="studio-title">
  <div class="shell studio-section__grid">
    <div class="studio-section__statement">
      <p class="t-label">09 / About Digi Tracks</p>
      <h2 id="studio-title">One studio.<br><em>Clear boundaries.</em></h2>
    </div>
    <div class="studio-section__copy">
      <p>Digi Tracks is a product-led technology company. Our portfolio spans operational platforms, focused tools and learning systems, with MIND ONE as the flagship and Procurement as a connected category.</p>
      <p>Each product keeps its own deployment, licensing and access boundary. The portfolio connects the conversation—not your data.</p>
      <a class="text-link" href="/about/">Read our approach<span aria-hidden="true">↗</span></a>
    </div>
    <dl class="studio-section__ledger" aria-label="Portfolio facts">
      <div><dt>Catalogue entries</dt><dd>{catalogueCount}</dd></div>
      <div><dt>Public origins</dt><dd>{String(publicOriginCount).padStart(2, "0")}</dd></div>
      <div><dt>Request-only editions</dt><dd>{String(requestOnlyCount).padStart(2, "0")}</dd></div>
    </dl>
  </div>
</section>

<section class="closing-section" aria-labelledby="closing-title">
  <div class="shell closing-section__grid">
    <div>
      <p class="t-label">10 / Start here</p>
      <h2 id="closing-title">Bring the workflow.<br><em>Find the fit.</em></h2>
    </div>
    <div class="closing-section__action">
      <p>Tell us what needs to work better. We will start with the right product, evidence and next step—not a predetermined package.</p>
      <Button href={contactHref} ctaId="request-conversation">Start a conversation</Button>
    </div>
  </div>
  <div class="closing-section__word" aria-hidden="true">Digi Tracks</div>
</section>
