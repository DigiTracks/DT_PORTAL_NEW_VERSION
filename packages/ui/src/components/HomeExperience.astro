---
import { productRegistry, toPublicProducts, type PublicProductRecord } from "@digitracks/catalog";
import { routeRegistry } from "@digitracks/seo";
import Button from "./Button.astro";
import EcosystemSculpture from "./EcosystemSculpture.tsx";
import ProductMark from "./ProductMark";

interface Props {
  contactHref: string;
}

const { contactHref } = Astro.props;
const products = toPublicProducts(productRegistry);
const sculptureProducts = products.map(({ id, name, category, logo }) => ({ id, name, category, logo }));
const catalogueCount = products.length;
const publicOriginCount = new Set(routeRegistry.map((route) => route.origin)).size;
const mindone = products.find((product) => product.id === "mindone")!;
const mindoneComplete = products.find((product) => product.id === "mindone-pro")!;
const vedikChildren = ["vedik-school-erp", "unnati", "vedik-university", "vedik-social", "campus-grid"]
  .map((id) => products.find((product) => product.id === id))
  .filter((product): product is PublicProductRecord => Boolean(product));
const elevatedProducts = [
  {
    product: products.find((product) => product.id === "vedik")!,
    headline: "Run the education ecosystem.",
    copy: "Vedik connects school, college, university, community and placement workflows around one education mission, with one connected operating model.",
    capabilityLimit: 5,
    cta: "See Vedik in action",
    intent: "product-enquiry",
    ctaId: "request-product-interest"
  },
  {
    product: products.find((product) => product.id === "nipuna")!,
    headline: "Review the candidate.",
    copy: "Local résumé intake, OCR and deterministic candidate matching for hiring teams that need a clear, reviewable pipeline rather than an opaque generative score.",
    capabilityLimit: 8,
    cta: "Book a Nipuna walkthrough",
    intent: "consultation",
    ctaId: "request-product-consultation"
  }
] as const;
const procurementRoles: Record<string, string> = {
  vertex: "Operate",
  vantor: "Control",
  procure5: "Verify",
  sherpa: "Learn"
};
const procurementProductIds = ["vertex", "vantor", "procure5", "sherpa"];
const procurementProducts = procurementProductIds
  .map((id) => products.find((product) => product.id === id))
  .filter((product): product is PublicProductRecord => Boolean(product));
const practiceSteps = [
  ["01", "Ground", "Résumé + role brief"],
  ["02", "Respond", "Speak or type"],
  ["03", "Coach", "Answer-specific guidance"],
  ["04", "Debrief", "Priorities + drill sheet"]
] as const;
---

<section class="hero hero--home" data-enter aria-labelledby="home-title">
  <div class="hero-home__grid shell">
    <div class="hero-home__copy">
      <p class="t-label hero-home__eyebrow"><span class="signal-dot" aria-hidden="true"></span>Digi Tracks / Product-led technology</p>
      <h1 id="home-title">Complex work.<br><em>Clear systems.</em></h1>
      <p class="hero-home__lede">Digi Tracks turns specialised work into clearer systems across education, recruitment, procurement, engineering and people operations. Explore the portfolio and find the system that fits the work.</p>
      <div class="button-row">
        <Button href="/products/" ctaId="explore-products">Explore all products</Button>
        <Button href={contactHref} variant="secondary" ctaId="request-demo">Start a conversation</Button>
      </div>
      <dl class="hero-home__stats">
        <div><dt>37</dt><dd>Products in the catalogue</dd></div>
        <div><dt>06</dt><dd>Industry paths</dd></div>
        <div><dt>03</dt><dd>Deployment models</dd></div>
      </dl>
    </div>
    <div class="hero-home__visual">
      <EcosystemSculpture
        products={sculptureProducts}
        client:media="(min-width: 721px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
      />
      <noscript><style is:inline>.ecosystem-sculpture__fallback{opacity:1!important;visibility:visible!important}</style></noscript>
    </div>
  </div>
  <div class="hero-home__foot shell">
    <span>Scroll to enter the portfolio</span>
    <span>Talk to us about deployment, access and rollout.</span>
  </div>
</section>

<section class="home-flagship section" aria-labelledby="home-flagship-title">
  <div class="shell home-flagship__grid">
    <div class="home-flagship__copy">
      <p class="t-label">Flagship / MIND ONE family</p>
      <h2 id="home-flagship-title">One family.<br><em>Two ways to practise.</em></h2>
      <p>MIND ONE grounds interview practice in the candidate’s résumé and the role brief. Basic is the free, focused edition; Complete adds durable history, progress and role-development tools to the full feature set.</p>
      <dl class="home-flagship__facts">
        <div><dt>MIND ONE Basic</dt><dd>Free / focused practice</dd></div>
        <div><dt>MIND ONE Complete</dt><dd>Full MIND ONE feature access</dd></div>
        <div><dt>Availability</dt><dd>Available now</dd></div>
      </dl>
      <div class="button-row">
        <Button href="/contact/?intent=product-enquiry&product=mindone" ctaId="request-mindone-access">Get MIND ONE access</Button>
        <Button href="/products/mindone/compare/" variant="secondary" ctaId="compare-mindone-editions">Compare Basic and Complete</Button>
      </div>
      <p class="home-flagship__note">Complete unlocks the full feature set, hosted AI included, under your provider's fair-use terms.</p>
    </div>
    <div class="mindone-family">
      <div class="mindone-family__head"><span>MIND ONE / Shared practice model</span><span>Available now</span></div>
      <ol class="mindone-family__sequence">
        {practiceSteps.map(([number, title, detail]) => <li><span>{number}</span><div><strong>{title}</strong><small>{detail}</small></div><i aria-hidden="true"></i></li>)}
      </ol>
      <div class="mindone-family__editions">
        <a href="/products/mindone/">
          <div class="mindone-family__edition-mark"><ProductMark product={mindone} size={42} /><span>Free / focused</span></div>
          <h3>MIND ONE Basic</h3>
          <p>Grounded questions, spoken or typed answers, coaching and a focused debrief.</p>
          <small>Inspect Basic <span aria-hidden="true">↗</span></small>
        </a>
        <a href="/products/mindone-pro/">
          <div class="mindone-family__edition-mark"><ProductMark product={mindoneComplete} size={42} /><span>Full feature access</span></div>
          <h3>MIND ONE Complete</h3>
          <p>Adds saved history, résumé/JD comparison, learning goals, progress and role-development maps.</p>
          <small>Inspect Complete <span aria-hidden="true">↗</span></small>
        </a>
      </div>
      <div class="mindone-family__foot"><span>Résumé-grounded</span><span>Answer-specific</span><span>Local-only default</span></div>
    </div>
  </div>
</section>

<section class="home-duo section" aria-labelledby="home-duo-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">Education & recruitment</p><h2 id="home-duo-title">Institutions and hiring teams.<br><em>Different systems.</em></h2></div>
      <p>Vedik connects an education portfolio. Nipuna supports local-first recruiting. Each is a complete system with its own users, data, deployment and integrations.</p>
    </div>
    <div class="home-duo__grid">
      {elevatedProducts.map(({ product, headline, copy, capabilityLimit, cta, intent, ctaId }) => (
        <article class="duo-product">
          <header>
            <ProductMark product={product} size={52} />
            <div class="duo-product__tag">
              <p class="t-label">{product.category}</p>
              <p class="duo-product__status">{product.status}</p>
            </div>
          </header>
          <h3>{headline}</h3>
          <p class="duo-product__name">{product.name}</p>
          <p>{copy}</p>
          <ol class="duo-product__map" aria-label={`${product.name} selected capabilities`}>
            {product.capabilities.slice(0, capabilityLimit).map((capability) => <li key={capability}><strong>{capability}</strong></li>)}
          </ol>
          {product.id === "vedik" && (
            <nav class="duo-product__family" aria-label="Vedik education ecosystem">
              <p class="t-label">Within the Vedik ecosystem</p>
              {vedikChildren.map((child) => <a href={`${child.route}/`}>{child.name}<span aria-hidden="true">↗</span></a>)}
            </nav>
          )}
          <p class="duo-product__evidence"><strong>Included.</strong> Deployment, identity and integrations are scoped with your team, in writing.</p>
          <Button href={`/contact/?intent=${intent}&product=${product.id}`} variant="secondary" ctaId={ctaId}>{cta}</Button>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="home-procurement section" aria-labelledby="home-procurement-title">
  <div class="shell">
    <div class="home-procurement__head">
      <div><p class="t-label">Procurement portfolio</p><h2 id="home-procurement-title">Different jobs.<br><em>Deliberate tools.</em></h2></div>
      <div><p>Operate projects and purchasing, control a self-hosted environment, verify procurement integrity or build practical capability. The category connects the conversation—not a shared data layer.</p><Button href="/procurement-software/" variant="secondary" ctaId="explore-procurement">Explore the procurement ecosystem</Button></div>
    </div>
    <ol class="home-procurement__grid">
      {procurementProducts.map((product) => (
        <li>
          <a href={`${product.route}/`}>
            <div class="home-procurement__card-head"><ProductMark product={product} size={46} /></div>
            <p class="t-label">{procurementRoles[product.id]}</p>
            <h3>{product.name}</h3>
            <p>{product.summary}</p>
            <small>{product.status}</small>
            <i aria-hidden="true">↗</i>
          </a>
        </li>
      ))}
    </ol>
    <div class="home-procurement__learning">
      <div><p class="t-label">ProcureSherpa Learning</p><h3>Learn the work. Then use the tool.</h3></div>
      <p>Academy modules, calculators, reference material and saved work—the learning layer that sits beside the procurement tools.</p>
      <a class="text-link" href="https://procuresherpa.digitracks.net/">Open ProcureSherpa Learning<span aria-hidden="true">↗</span></a>
    </div>
    <p class="home-procurement__boundary">Each tool stands on its own. Deployment, connectors and support are scoped per product, in writing.</p>
  </div>
</section>

<section class="home-index section" aria-labelledby="home-index-title">
  <div class="shell">
    <div class="home-index__head">
      <div><p class="t-label">The portfolio</p><h2 id="home-index-title">Four doors.<br><em>One catalogue.</em></h2></div>
      <p>Every product, sector and engagement has its own page. Start with the one that matches the decision in front of you.</p>
    </div>
    <ol class="home-index__grid">
      <li>
        <a class="home-index__card home-index__card--gold" href="/products/">
          <span class="home-index__ghost" aria-hidden="true">01</span>
          <p class="t-label">Catalogue</p>
          <h3>Products</h3>
          <p>Thirty-seven records across enterprise operations, procurement, education, people, engineering and field operations.</p>
          <span class="home-index__meta">{catalogueCount} products<span aria-hidden="true">→</span></span>
        </a>
      </li>
      <li>
        <a class="home-index__card home-index__card--cobalt" href="/industries/">
          <span class="home-index__ghost" aria-hidden="true">02</span>
          <p class="t-label">Sector paths</p>
          <h3>Industries</h3>
          <p>Six operating contexts, each mapped to the products that fit the work and the deployment behind them.</p>
          <span class="home-index__meta">06 industry paths<span aria-hidden="true">→</span></span>
        </a>
      </li>
      <li>
        <a class="home-index__card home-index__card--mint" href="/solutions/">
          <span class="home-index__ghost" aria-hidden="true">03</span>
          <p class="t-label">Capability</p>
          <h3>Solutions</h3>
          <p>Start from the workflow instead of the label: audit trails, offline sites, multi-entity structure and regulated records.</p>
          <span class="home-index__meta">06 solution paths<span aria-hidden="true">→</span></span>
        </a>
      </li>
      <li>
        <a class="home-index__card home-index__card--clay" href="/services/">
          <span class="home-index__ghost" aria-hidden="true">04</span>
          <p class="t-label">Engagements</p>
          <h3>Services</h3>
          <p>Product fit, implementation, migration and support — scoped, agreed and handed over with named ownership.</p>
          <span class="home-index__meta">04 engagement paths<span aria-hidden="true">→</span></span>
        </a>
      </li>
    </ol>
  </div>
</section>

<section class="studio-section section" aria-labelledby="studio-title">
  <div class="shell studio-section__grid">
    <div class="studio-section__statement">
      <p class="t-label">About Digi Tracks</p>
      <h2 id="studio-title">One studio.<br><em>Clear boundaries.</em></h2>
      <ul class="studio-section__scope">
        <li><span>01</span>Operational platforms</li>
        <li><span>02</span>Focused tools</li>
        <li><span>03</span>Learning systems</li>
      </ul>
    </div>
    <div class="studio-section__copy">
      <p>Digi Tracks is a product-led technology company. Our portfolio spans operational platforms, focused tools and learning systems, with MIND ONE as the flagship and Procurement as a connected category.</p>
      <p>One studio behind every product, with deployment, licensing and access agreed for each system your team runs.</p>
      <a class="text-link" href="/about/">Read our approach<span aria-hidden="true">↗</span></a>
    </div>
    <dl class="studio-section__ledger" aria-label="Portfolio facts">
      <div><dt>Catalogue entries</dt><dd>{catalogueCount}</dd></div>
      <div><dt>Public origins</dt><dd>{String(publicOriginCount).padStart(2, "0")}</dd></div>
      <div><dt>Solution paths</dt><dd>06</dd></div>
    </dl>
  </div>
</section>

<section class="closing-section" aria-labelledby="closing-title">
  <div class="shell closing-section__grid">
    <div>
      <p class="t-label">Start here</p>
      <h2 id="closing-title">Bring the workflow.<br><em>Find the fit.</em></h2>
    </div>
    <div class="closing-section__action">
      <p>Tell us what needs to work better. We will start with the right product, evidence and next step—not a predetermined package.</p>
      <Button href={contactHref} ctaId="request-conversation">Start a conversation</Button>
    </div>
  </div>
  <div class="closing-section__word" aria-hidden="true">Digi Tracks</div>
</section>
