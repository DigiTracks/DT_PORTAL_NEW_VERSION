---
import { routeRegistry, type RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";

interface Props {
  routes: readonly RouteRecord[];
}

const { routes } = Astro.props;
const learningRoutes = routes.filter((route) => route.path !== "/" && route.path !== "/contact/");
const publicOriginCount = new Set(routeRegistry.map((route) => route.origin)).size;
const learningThemes: Record<string, { label: string; mark: string }> = {
  "/hcmfusion/": { label: "People operations", mark: "HC" },
  "/learnpmo/": { label: "Project delivery", mark: "PM" },
  "/procuresherpa/": { label: "Procurement", mark: "PS" },
  "/sourcecraft/": { label: "Contract language", mark: "SC" }
};
const requestHref = "https://digitracks.net/contact/?intent=consultation&origin=learn";
const platformHrefs: Record<string, string> = {
  "/hcmfusion/": "https://hcmfusion.digitracks.net/",
  "/learnpmo/": "https://learnpmo.digitracks.net/",
  "/procuresherpa/": "https://procuresherpa.digitracks.net/",
  "/sourcecraft/": "https://sourcecraft.digitracks.net/"
};
---

<section class="learning-hero" aria-labelledby="learning-title">
  <div class="shell learning-hero__grid">
    <div class="learning-hero__copy">
      <p class="t-label">Digi Tracks learning / public practice origins</p>
      <h1 id="learning-title">Learn the work.<br><em>Then do the work.</em></h1>
      <p class="learning-hero__lede">A direct route into procurement, project delivery, people operations and the wider Digi Tracks software ecosystem.</p>
      <div class="button-row">
        <Button href="#learning-paths" ctaId="explore-learning-paths">Choose a learning path</Button>
        <Button href={requestHref} variant="secondary">Ask about access</Button>
      </div>
    </div>
    <nav class="learning-orbit" aria-label="Featured learning paths">
      <span class="learning-orbit__rule" aria-hidden="true"></span>
      <span class="learning-orbit__core" aria-hidden="true"><small>DT / LEARN</small><strong>Choose<br>a direction</strong></span>
      {learningRoutes.map((route, index) => {
        const theme = learningThemes[route.path] ?? { label: "Learning path", mark: "DT" };
        return <a key={route.id} class={`learning-orbit__card learning-orbit__card--${index + 1}`} href={platformHrefs[route.path] ?? route.path} rel="noopener">
          <span>{String(index + 1).padStart(2, "0")} / {theme.mark}</span>
          <strong>{theme.label}</strong>
          <small>{route.title.replace(" | Digi Tracks", "").split(" — ")[0]}</small>
        </a>;
      })}
    </nav>
  </div>
  <div class="shell learning-hero__ledger">
    <span>{String(publicOriginCount).padStart(2, "0")} public origins</span><span>Direct product context</span><span>Open links, no account</span>
  </div>
</section>

<section class="section learning-paths" id="learning-paths" aria-labelledby="paths-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">Choose your direction</p><h2 id="paths-title">Start with the system you need to understand.</h2></div>
      <p>Each path is its own public site. Open it directly — nothing sits behind a sign-up wall.</p>
    </div>
    <ol class="learning-path-grid">
      {learningRoutes.map((route, index) => <li key={route.id}>
        <a href={platformHrefs[route.path] ?? route.path} rel="noopener">
          <span class="learning-path-grid__number">{String(index + 1).padStart(2, "0")}</span>
          <div><p class="t-label">Learning origin</p><h3>{route.title.replace(" | Digi Tracks", "")}</h3><p>{route.description}</p></div>
          <span class="learning-path-grid__arrow" aria-hidden="true">↗</span>
        </a>
      </li>)}
    </ol>
  </div>
</section>

<section class="section section--ruled learning-boundary" aria-labelledby="learning-boundary-title">
  <div class="shell learning-boundary__grid">
    <div><p class="t-label">Direct links</p><h2 id="learning-boundary-title">Everything public is open.</h2></div>
    <div class="prose"><p>Each platform is a live site with its own material. Use the links directly; no account, no enrolment step and no waiting for approval.</p><p>If you want a session run with your own contract, plan or process, talk to the studio and we will bring the platform to that conversation.</p><Button href={requestHref} variant="secondary">Talk to the studio</Button></div>
  </div>
</section>
