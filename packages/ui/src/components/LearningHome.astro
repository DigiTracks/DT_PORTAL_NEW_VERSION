---
import Button from "./Button.astro";

const platforms = [
  {
    key: "sourcecraft",
    mark: "SC",
    name: "SourceCraft",
    label: "Contract language",
    href: "https://sourcecraft.digitracks.net/",
    domain: "sourcecraft.digitracks.net",
    icon: "/brand/platform-sourcecraft.webp",
    lede: "Procurement and contract language in plain words, with the same term read across regions."
  },
  {
    key: "learnpmo",
    mark: "PM",
    name: "LearnPMO",
    label: "Project delivery",
    href: "https://learnpmo.digitracks.net/",
    domain: "learnpmo.digitracks.net",
    icon: "/brand/platform-learnpmo.webp",
    lede: "Lessons, mock exams and industry practice for project, programme and portfolio delivery."
  },
  {
    key: "procuresherpa",
    mark: "PS",
    name: "ProcureSherpa Learning",
    label: "Procurement",
    href: "https://procuresherpa.digitracks.net/",
    domain: "procuresherpa.digitracks.net",
    icon: "/brand/platform-procuresherpa.webp",
    lede: "Academy modules, calculators, SOPs and templates for sourcing, contracts and spend."
  },
  {
    key: "hcmfusion",
    mark: "HC",
    name: "HCM Fusion",
    label: "People operations",
    href: "https://hcmfusion.digitracks.net/",
    domain: "hcmfusion.digitracks.net",
    icon: "/brand/platform-hcmfusion.webp",
    lede: "Oracle Fusion Cloud HCM taught in configuration order, with practice labs at every step."
  }
];

const requestHref = "https://digitracks.net/contact/?intent=consultation&origin=learn";
---

<section class="learning-hero" aria-labelledby="learning-title">
  <div class="shell learning-hero__grid">
    <div class="learning-hero__copy">
      <p class="t-label">Digi Tracks learning / four live platforms</p>
      <h1 id="learning-title">Four platforms.<br><em>One click each.</em></h1>
      <p class="learning-hero__lede">Four learning platforms, all live. Each card below goes straight to the real application at its own address — this page is only the door.</p>
      <div class="button-row">
        <Button href="#learning-paths" ctaId="explore-learning-paths">Choose a platform</Button>
        <Button href={requestHref} variant="secondary">Talk to the studio</Button>
      </div>
    </div>
    <nav class="learning-orbit" aria-label="Learning platforms">
      <span class="learning-orbit__rule" aria-hidden="true"></span>
      <span class="learning-orbit__core" aria-hidden="true"><small>DT / LEARN</small><strong>Four<br>doors</strong></span>
      {platforms.map((platform, index) => (
        <a class={`learning-orbit__card learning-orbit__card--${index + 1}`} href={platform.href} rel="noreferrer" target="_blank" data-live>
          <span>{String(index + 1).padStart(2, "0")} / {platform.mark}</span>
          <strong>{platform.label}</strong>
          <small>{platform.name}</small>
        </a>
      ))}
    </nav>
  </div>
  <div class="shell learning-hero__ledger">
    <span>04 live platforms</span><span>Direct links</span><span>Opens the live site</span>
  </div>
</section>

<section class="section learning-paths" id="learning-paths" aria-labelledby="paths-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="t-label">The four platforms</p><h2 id="paths-title">Open the one you need.</h2></div>
      <p>Every row is a working link to the live application. Nothing is rebuilt or mirrored here, and nothing stands between the link and the platform.</p>
    </div>
    <ol class="learning-path-grid">
      {platforms.map((platform, index) => <li key={platform.key}>
        <a href={platform.href} rel="noreferrer" target="_blank" data-live>
          <span class="learning-path-grid__number">{String(index + 1).padStart(2, "0")}</span>
          <img class="learning-path-grid__icon" src={platform.icon} alt="" width="56" height="56" loading="lazy" />
          <div class="learning-path-grid__copy">
            <p class="t-label">{platform.label}</p>
            <h3>{platform.name}</h3>
            <p>{platform.lede}</p>
            <span class="learning-path-grid__open">{platform.domain}<span aria-hidden="true">Open live ↗</span></span>
          </div>
        </a>
      </li>)}
    </ol>
  </div>
</section>

<section class="section section--ruled learning-boundary" aria-labelledby="learning-boundary-title">
  <div class="shell learning-boundary__grid">
    <div><p class="t-label">One page, four addresses</p><h2 id="learning-boundary-title">The platforms are the destination.</h2></div>
    <div class="prose">
      <p>SourceCraft, LearnPMO, ProcureSherpa Learning and HCM Fusion each run as their own application. This page links to them; it does not copy them, and it holds none of their content.</p>
      <p>Each platform keeps its own saved work in your browser, on this device. If a guided walkthrough would help, the studio will run one against your own material.</p>
      <Button href={requestHref} variant="secondary">Talk to the studio</Button>
    </div>
  </div>
</section>
