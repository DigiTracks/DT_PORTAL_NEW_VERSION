---
import type { ProductRecord } from "@digitracks/catalog";
import { hubRegistry, isDemoProduct, productRegistry, salesAvailability, salesStatus, solutionRegistry, toPublicProducts } from "@digitracks/catalog";
import { breadcrumbSchema, routeUrl, type RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";
import EditionComparison from "./EditionComparison.astro";
import FlagshipProduct from "./FlagshipProduct.astro";
import HomeExperience from "./HomeExperience.astro";
import IndustryPath from "./IndustryPath.astro";
import LeadForm from "./LeadForm.tsx";
import MarketingPage from "./MarketingPage.astro";
import PageHero from "./PageHero.astro";
import ProcurementEcosystem from "./ProcurementEcosystem.astro";
import ProductCatalogue from "./ProductCatalogue.tsx";
import ProductInstrument from "./ProductInstrument.astro";
import ServicesPage from "./ServicesPage.astro";
import SolutionsIndex from "./SolutionsIndex.astro";
import HubPage from "./HubPage.astro";
import LegalPage from "./LegalPage.astro";
import SiteLayout from "./SiteLayout.astro";
import VedikEcosystem from "./VedikEcosystem.astro";
import "../styles/base.css";
import commonStyles from "../styles/portal-common.css?inline";
import catalogueStyles from "../styles/portal-catalogue.css?inline";
import contactStyles from "../styles/portal-contact.css?inline";
import flagshipStyles from "../styles/portal-flagship.css?inline";
import homeStyles from "../styles/portal-home.css?inline";
import industryStyles from "../styles/portal-industry.css?inline";
import procurementStyles from "../styles/portal-procurement.css?inline";
import productStyles from "../styles/portal-product.css?inline";
import servicesStyles from "../styles/portal-services.css?inline";

interface Props {
  route: RouteRecord;
  product?: ProductRecord;
}

const { route, product } = Astro.props;
const canonical = routeUrl(route.origin, route.path);
const titleWithoutSite = route.title.split(" | ")[0];
const breadcrumbs = route.breadcrumbs.map((item) => ({ name: item.label, item: routeUrl(route.origin, item.path) }));
const schema = route.indexable
  ? [
      breadcrumbSchema(breadcrumbs),
      ...(product && route.template === "product-detail" ? [{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: product.name,
        description: product.summary,
        url: canonical,
        applicationCategory: product.category,
        operatingSystem: product.platforms.join(", ") || undefined
      }] : [])
    ]
  : [];
const structuredData = schema.length ? JSON.stringify(schema).replace(/</g, "\\u003c") : undefined;
const products = productRegistry;
const publicProducts = toPublicProducts(products);
const demoEligibleProductIds = products.filter(isDemoProduct).map((item) => item.id);
const leadProductOptions = publicProducts
  .filter((item) => item.availability !== "internal" && item.availability !== "retired")
  .map(({ id, name }) => ({ id, name, demoEligible: demoEligibleProductIds.includes(id) }));
const mindoneComplete = products.find((item) => item.id === "mindone-pro");
const productSupportsDemo = product ? isDemoProduct(product) : false;
const isFlagship = product?.id === "mindone" || product?.id === "mindone-pro";
const contactHref = product
  ? `/contact/?intent=${productSupportsDemo ? "demo" : "product-enquiry"}&product=${encodeURIComponent(product.id)}`
  : route.template === "edition-comparison"
    ? "/contact/?intent=product-enquiry&product=mindone"
    : route.template === "services" || route.template === "procurement-ecosystem"
      ? "/contact/?intent=consultation"
      : "/contact/?intent=consultation";
const requestLabel = product && !productSupportsDemo
  ? "Register product interest"
  : route.template === "procurement-ecosystem"
    ? "Discuss procurement"
    : product
      ? "Request a demo"
      : "Start a conversation";
const licensingHref = product
  ? `/contact/?intent=product-enquiry&product=${encodeURIComponent(product.id)}`
  : "/contact/?intent=product-enquiry";
const relatedProducts = product
  ? products.filter((item) => item.id !== product.id && (item.parentId === product.parentId || item.category === product.category)).slice(0, 4)
  : [];
const nestedProducts = product ? products.filter((item) => item.parentId === product.id) : [];
const compactProductTitle = product ? !product.name.includes(" ") && product.name.length > 12 : false;
const productTitleMarkup = product ? product.name.replace(/([a-z])([A-Z])/g, "$1<wbr>$2") : "";
const solutions = solutionRegistry;
const hubs = hubRegistry;
const isHome = route.template === "home";
const isContact = route.path === "/contact/";
const isFlagshipPage = isFlagship && Boolean(mindoneComplete);
const isVedikEcosystem = product?.id === "vedik";
const isEditionComparison = route.template === "edition-comparison";
const isProcurementEcosystem = route.template === "procurement-ecosystem";
const isServices = route.template === "services";
const isProductIndex = route.template === "product-index";
const isSolutionIndex = route.template === "solution-index" || route.template === "industry-index";
const isHub = route.template === "capability-hub";
const marketingPaths = ["/about/", "/engineering/", "/faq/", "/trust/", "/pricing/", "/offline-first-software/"];
const isMarketingPage = route.template === "marketing" && marketingPaths.includes(route.path);
const hub = hubs.find((item) => `/${item.id}/` === route.path);
const solution = solutions.find((item) => `/solutions/${item.id}/` === route.path);
const pageStyleKey = isHome
  ? "home"
  : isFlagshipPage || isEditionComparison
    ? "flagship"
    : isProcurementEcosystem
      ? "procurement"
      : isServices
        ? "services"
        : product
          ? "product"
          : isProductIndex
            ? "catalogue"
            : isSolutionIndex || solution
              ? "industry"
              : isHub
                ? "product"
                : isContact
                  ? "contact"
                  : "common";
const routeStyles: Record<string, string> = {
  home: homeStyles,
  flagship: flagshipStyles,
  procurement: procurementStyles,
  services: servicesStyles,
  product: productStyles,
  catalogue: catalogueStyles,
  industry: industryStyles,
  contact: contactStyles,
  common: ""
};
const pageStyles = [
  commonStyles,
  routeStyles[pageStyleKey],
  pageStyleKey === "home" || pageStyleKey === "catalogue" ? productStyles : ""
].filter(Boolean).join("\n");
---

<SiteLayout
  title={route.title}
  description={route.description}
  origin={route.canonicalOrigin ?? routeUrl(route.origin, "/")}
  canonical={canonical}
  indexable={route.indexable}
  socialImage={route.socialImage}
  structuredData={structuredData}
  pageStyles={pageStyles}
  requestHref={contactHref}
  requestLabel={requestLabel}
  bodyClass={`page-${route.template}${isFlagshipPage ? " page-flagship-product" : ""}${isVedikEcosystem ? " page-vedik-ecosystem" : ""}`}
  mainClass="site-main"
>
  {!isHome && <nav class="breadcrumbs shell" aria-label="Breadcrumb">
    <ol>
      {route.breadcrumbs.map((item, index) => <li>{index < route.breadcrumbs.length - 1 ? <a href={routeUrl(route.origin, item.path)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
    </ol>
  </nav>}

  {isHome ? (
    <HomeExperience contactHref={contactHref} />
  ) : isFlagshipPage && product && mindoneComplete ? (
    <FlagshipProduct product={product} />
  ) : isVedikEcosystem && product ? (
    <VedikEcosystem product={product} />
  ) : isEditionComparison ? (
    <EditionComparison route={route} />
  ) : isProcurementEcosystem ? (
    <ProcurementEcosystem route={route} />
  ) : isServices ? (
    <ServicesPage route={route} />
  ) : product ? (
    <>
      <section class="hero hero--product" aria-labelledby="product-title">
        <div class="shell hero-product__grid">
          <div class="hero-product__copy">
            <p class="t-label">{product.category} / {salesStatus(product.status)}</p>
            <h1 id="product-title" class={compactProductTitle ? "hero-product__title--compact" : undefined} set:html={productTitleMarkup} />
            <p class="hero-product__lede">{product.summary}</p>
            <div class="button-row">
              <Button href={contactHref} ctaId={productSupportsDemo ? "request-product-demo" : "request-product-interest"}>{productSupportsDemo ? "Book a full demo" : "Talk to the product team"}</Button>
              <Button href={licensingHref} variant="secondary" ctaId="request-quote">Discuss licensing</Button>
            </div>
            <dl class="hero-product__facts">
              <div><dt>Deployment</dt><dd>{product.deployment}</dd></div>
              <div><dt>Platforms</dt><dd>{product.platforms.join(" · ") || "Confirmed at onboarding"}</dd></div>
            </dl>
          </div>
          <ProductInstrument product={product} nestedProducts={nestedProducts} />
        </div>
      </section>
      <section class="section product-scope" aria-labelledby="scope-title">
        <div class="shell">
          <div class="product-scope__intro">
            <p class="t-label">What it covers</p>
            <h2 id="scope-title">{titleWithoutSite} in practice.</h2>
            <p class="product-scope__body">{product.description}</p>
            <p class="product-scope__audience"><span class="t-label">Built for</span>{product.audience}</p>
          </div>
          <dl class="product-facts">
            <div><dt>Availability</dt><dd>{salesAvailability(product.availability)}</dd></div>
            <div><dt>Deployment</dt><dd>{product.deployment}</dd></div>
            <div><dt>Platforms</dt><dd>{product.platforms.join(" · ") || "Confirmed at onboarding"}</dd></div>
            <div><dt>Licence</dt><dd>{product.licenceNote ?? (product.licenseModel === "open-source" ? "Open source" : product.licenseModel === "source-available" ? "Source available" : "Per product, quoted on scope")}</dd></div>
          </dl>
        </div>
      </section>
      <section class="section section--ruled" aria-labelledby="capabilities-title">
        <div class="shell"><div class="section-head"><div><p class="t-label">Capabilities</p><h2 id="capabilities-title">{product.capabilities.length} capabilities in scope.</h2></div><p>Every capability below is part of the licensed product, confirmed against your deployment.</p></div>
          {product.capabilities.length ? <ul class="index-list index-list--simple">{product.capabilities.map((capability) => <li><strong>{capability}</strong></li>)}</ul> : <p>Capability details are confirmed during onboarding.</p>}
        </div>
      </section>
      {relatedProducts.length > 0 && <section class="section section--ruled" aria-labelledby="related-title"><div class="shell"><div class="section-head"><div><p class="t-label">Related</p><h2 id="related-title">Compare nearby tools.</h2></div></div><ul class="index-list">{relatedProducts.map((item) => <li><a href={`${item.route}/`}><strong>{item.name}</strong><span>{item.summary}</span><small>View</small></a></li>)}</ul></div></section>}
      <section class="product-cta on-night" aria-labelledby="product-cta-title">
        <div class="shell product-cta__inner">
          <div>
            <p class="t-label">Next step</p>
            <h2 id="product-cta-title">See {product.name} on your workflow.</h2>
            <p>Book a demo or a scoping call. We walk the product through your own process, deployment constraints and integration questions, then confirm licensing.</p>
          </div>
          <div class="button-row">
            <Button href={contactHref} ctaId={productSupportsDemo ? "request-product-demo" : "request-product-interest"}>{productSupportsDemo ? "Book a demo" : "Talk to the product team"}</Button>
            <Button href={licensingHref} variant="secondary" ctaId="request-quote">Discuss licensing</Button>
          </div>
        </div>
      </section>
    </>
  ) : isProductIndex ? (
    <ProductCatalogue products={publicProducts} demoEligibleProductIds={demoEligibleProductIds} contactHref={contactHref} client:visible />
  ) : isSolutionIndex ? (
    <SolutionsIndex route={route} solutions={solutions} products={publicProducts} variant={route.template === "industry-index" ? "industries" : "solutions"} />
  ) : isHub && hub ? (
    <HubPage hub={hub} products={publicProducts} contactHref={contactHref} />
  ) : solution ? (
    <IndustryPath solution={solution} />
  ) : isMarketingPage ? (
    <MarketingPage route={route} />
  ) : isContact ? (
    <>
      <section class="contact-hero" aria-labelledby="page-title">
        <div class="shell contact-hero__grid">
          <div class="contact-hero__copy">
            <p class="t-label"><span class="signal-dot" aria-hidden="true"></span>Product, demo, migration or support</p>
            <h1 id="page-title">Start a useful<br /><em>conversation.</em></h1>
            <p class="contact-hero__lede">Tell us what you are trying to change. We route the enquiry to the product team that owns the answer and reply with the fit, the deployment model and the next step.</p>
          </div>
          <ul class="contact-routes">
            <li><span>01</span><div><strong>Product &amp; pricing</strong><p>Scope, licence model and what a rollout involves.</p></div></li>
            <li><span>02</span><div><strong>Demo</strong><p>Walk the workflow you care about on a real build.</p></div></li>
            <li><span>03</span><div><strong>Migration</strong><p>Move records and history across without losing the audit trail.</p></div></li>
            <li><span>04</span><div><strong>Support</strong><p>An issue in production, with a named route to the team.</p></div></li>
          </ul>
        </div>
      </section>
      <section class="section contact-section" aria-labelledby="enquiry-title"><div class="shell contact-layout"><div class="prose"><p class="t-label">Before you enquire</p><h2 id="enquiry-title">A few details make the first reply better.</h2><p>Include the workflow, current tools, deployment constraints and who needs to be involved. A name, a work email and the product you are considering are enough to start.</p><p>We reply by email with the product fit, the deployment questions worth answering and a proposed next step. Your details are used for that conversation only.</p></div><div class="panel panel__body"><LeadForm products={leadProductOptions} client:load /></div></div></section>
    </>
  ) : route.template === "legal" ? (
    <LegalPage route={route} />
  ) : route.contentStatus && route.contentStatus !== "approved" ? (
    <>
      <PageHero id="page-title" title={titleWithoutSite} eyebrow="Digi Tracks" lede={route.description} compact />
      <section class="section" aria-labelledby="boundary-title"><div class="shell prose"><p class="t-label">Record</p><h2 id="boundary-title">This record is being prepared.</h2><p>Product pages, documentation and the catalogue are live across the site. If you followed a link to this record and expected content, tell us which page you came from and we will point you to the right one.</p><div class="button-row"><Button href="/products/" variant="secondary">Browse products</Button><Button href="/contact/?intent=consultation" variant="secondary">Ask us about this record</Button></div></div></section>
    </>
  ) : (
    <>
      <PageHero id="page-title" title={titleWithoutSite} eyebrow="Digi Tracks" lede={route.description} compact />
      <section class="section" aria-labelledby="details-title"><div class="shell prose"><p class="t-label">Overview</p><h2 id="details-title">A practical next step.</h2><p>Tell us what you are trying to change and we will point to the product, deployment model and next step that fit.</p><Button href={contactHref} variant="secondary">Contact Digi Tracks</Button></div></section>
    </>
  )}
</SiteLayout>

<style>
  .contact-section { padding-block: clamp(2.4rem, 4vw, 3.6rem) clamp(3rem, 5vw, 4.5rem); }
  .contact-hero { padding-block: clamp(3.5rem, 6vw, 6rem); background: radial-gradient(ellipse at 80% 10%, rgb(245 207 101 / 22%), transparent 46%), var(--paper-bright); border-bottom: 1px solid rgb(13 27 46 / 12%); }
  .contact-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .contact-hero__copy { display: grid; gap: 1rem; }
  .contact-hero h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 5.4rem); font-weight: 500; letter-spacing: -0.05em; line-height: 0.94; color: var(--ink); }
  .contact-hero h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 400; color: var(--night); }
  .contact-hero__lede { margin: 0; max-width: 52ch; color: #3f4c5e; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.6; }
  .contact-routes { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(13 27 46 / 16%); }
  .contact-routes li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid rgb(13 27 46 / 12%); }
  .contact-routes span { padding-top: 0.2rem; color: #a4781f; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.14em; }
  .contact-routes strong { display: block; color: var(--ink); font-size: 0.98rem; font-weight: 600; }
  .contact-routes p { margin: 0.15rem 0 0; color: #4a5567; font-size: 0.9rem; line-height: 1.45; }
  @media (max-width: 900px) { .contact-hero__grid { grid-template-columns: 1fr; align-items: start; } }
  .product-scope .shell { display: grid; gap: clamp(2rem, 4vw, 3.4rem); }
  .product-scope__intro { display: grid; gap: 0.9rem; max-width: 66ch; }
  .product-scope__intro h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 3.2rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; color: var(--ink); }
  .product-scope__body { margin: 0; color: #3f4c5e; font-size: clamp(1.02rem, 1.3vw, 1.15rem); line-height: 1.65; }
  .product-scope__audience { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: baseline; margin: 0.3rem 0 0; color: #4a5567; font-size: 0.95rem; line-height: 1.5; }
  .product-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; background: rgb(13 27 46 / 14%); border-top: 1px solid rgb(13 27 46 / 14%); }
  .product-facts > div { display: grid; gap: 0.4rem; padding: 1.1rem 1.2rem; background: var(--paper-bright); }
  .product-facts dt { color: #7b8698; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .product-facts dd { margin: 0; color: var(--ink); font-size: 0.98rem; font-weight: 500; }
  .product-cta { padding-block: clamp(3.5rem, 6vw, 5.5rem); background: var(--night); color: var(--paper-bright); }
  :global(.page-product-detail) .section { padding-block: clamp(2.6rem, 4.2vw, 4rem); }
  .product-cta__inner { display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: 2rem; align-items: end; }
  .product-cta__inner h2 { margin: 0.6rem 0 0.8rem; font-family: var(--font-display); font-size: clamp(1.9rem, 3.4vw, 3rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.02; }
  .product-cta__inner p { margin: 0; max-width: 56ch; color: rgb(198 212 230 / 84%); line-height: 1.6; }
  @media (max-width: 980px) { .product-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .product-cta__inner { grid-template-columns: 1fr; align-items: start; } }
  @media (max-width: 560px) { .product-facts { grid-template-columns: 1fr; } }
</style>