---
import Button from "./Button.astro";
import type { RouteRecord } from "@digitracks/seo";

interface Props { route: RouteRecord }
const { route } = Astro.props;
const variant = route.path.replace(/\//g, "") as "sourcecraft" | "learnpmo" | "procuresherpa" | "hcmfusion";

const data = {
  sourcecraft: {
    label: "SourceCraft",
    href: "https://sourcecraft.digitracks.net/",
    access: "Free access — opens in the browser",
    eyebrow: "Digi Tracks learning / reference",
    lead: "Read the clause",
    accent: "before you sign it.",
    lede: "A reference library for procurement and contract language, with regional lenses for India, the United States, the United Kingdom and California. Every term is explained in plain language, then shown in the sentence where it does damage.",
    facts: [["Reference", "Glossary, clauses, comparisons"], ["Lenses", "India · US · UK · California"], ["Storage", "Saved terms stay in this browser"]]
  },
  learnpmo: {
    label: "LearnPMO",
    href: "https://learnpmo.digitracks.net/",
    access: "Free access — lessons, mock exams, simulator",
    eyebrow: "Digi Tracks learning / curriculum",
    lead: "Three levels,",
    accent: "one delivery habit.",
    lede: "PM360 Academy teaches project, programme and portfolio delivery in the order the work happens: scope first, then schedule and cost, then the registers a PMO actually runs. Mock exams and a practice simulator sit between the lessons.",
    facts: [["Path", "Foundation → Practitioner → PMO"], ["Practice", "Mock exams, simulator, registers"], ["Storage", "Progress stays in this browser"]]
  },
  procuresherpa: {
    label: "ProcureSherpa Learning",
    href: "https://procuresherpa.digitracks.net/",
    access: "Free access — modules, calculators, templates",
    eyebrow: "Digi Tracks learning / toolkit",
    lead: "Modules you can",
    accent: "use on Monday.",
    lede: "Procurement training built around the artefacts of the job: sourcing plans, evaluation grids, contract summaries, spend analyses. Each module ends with a calculator or a template you can fill in and take to a real negotiation.",
    facts: [["Modules", "Sourcing, contracts, spend, suppliers"], ["Tools", "Calculators, checklists, SOPs"], ["Storage", "Drafts stay in this browser"]]
  },
  hcmfusion: {
    label: "HCM Fusion",
    href: "https://hcmfusion.digitracks.net/",
    access: "Free access — every lesson open",
    eyebrow: "Digi Tracks learning / configuration",
    lead: "Configure in order,",
    accent: "not by menu.",
    lede: "Oracle Fusion Cloud HCM taught in configuration sequence: Core HR first, then absence, time and labour, payroll, recruiting and talent. Each module names the failure that appears when the step before it was skipped.",
    facts: [["Sequence", "Core HR → Payroll → Talent"], ["Labs", "One practice lab per module"], ["Storage", "Lab notes stay in this browser"]]
  }
} satisfies Record<string, { label: string; href: string; access: string; eyebrow: string; lead: string; accent: string; lede: string; facts: string[][] }>;

const page = data[variant];
const contactHref = "https://digitracks.net/contact/?intent=consultation&origin=" + route.origin + "&route=" + encodeURIComponent(route.path);

const terms = [
  { term: "Indemnity", plain: "One side agrees to cover the other's losses if a specific thing goes wrong.", watch: "Does it cover third-party claims only, or your own losses too?" },
  { term: "Limitation of liability", plain: "A cap on how much either side can recover, and which claims sit outside that cap.", watch: "Is the cap a multiple of fees, and does it survive breach of confidentiality?" },
  { term: "Force majeure", plain: "An event outside a party's control that excuses a delay or a missed obligation.", watch: "Which events are listed, and does it let either side walk away?" },
  { term: "Liquidated damages", plain: "A pre-agreed sum paid for a defined failure, usually late delivery.", watch: "Is it a genuine estimate of loss, or a penalty a court may refuse to enforce?" },
  { term: "Termination for convenience", plain: "Ending the contract without a breach, usually on notice.", watch: "What is payable on exit — unused licence, transition support, data return?" },
  { term: "Most favoured customer", plain: "A promise that this buyer gets terms no worse than anyone else.", watch: "How is it measured, how often, and what is the remedy when it is missed?" }
];
const reading = [
  { title: "Locate the obligation", body: "Find the sentence that says who must do what. Everything else in the clause is a condition, a limit or a remedy attached to that one obligation." },
  { title: "Find the consequence", body: "Read forward to the remedy. A clause with no consequence is a preference, not a commitment." },
  { title: "Compare the lens", body: "Switch region and read the same term again. Enforcement and defaults differ, and the difference is the negotiation point." },
  { title: "Write the question", body: "Turn the gap into one question for the counterparty. Saved terms keep the question with the clause that produced it." }
];
const levels = [
  { level: "01", name: "Foundation", body: "The vocabulary of delivery: charter, scope, WBS, dependencies, acceptance.", modules: ["Scope and the charter", "Work breakdown and estimates", "Schedules and critical path", "Stakeholders and communication"] },
  { level: "02", name: "Practitioner", body: "Running the work once it has started, including the parts that go wrong.", modules: ["Cost, budget and earned value", "Risk, issues and change control", "Procurement and vendor delivery", "Quality and acceptance"] },
  { level: "03", name: "PMO", body: "The registers and routines a PMO owns across several projects.", modules: ["Portfolio intake and prioritisation", "Benefits and stage gates", "Assurance and reporting", "Lessons learned that change the method"] }
];
const modules = [
  { name: "Sourcing strategy", body: "Make-or-buy, single versus competitive, and the award route that matches the risk.", output: "Sourcing plan" },
  { name: "Requirements and RFP", body: "Turning a need into weighted criteria that survive an audit.", output: "Evaluation grid" },
  { name: "Evaluation and negotiation", body: "Scoring, clarification rounds and the concession plan behind the number.", output: "Negotiation brief" },
  { name: "Contracting", body: "The commercial terms that carry the risk, and the summary a stakeholder will actually read.", output: "Contract summary" },
  { name: "Supplier management", body: "Reviews, scorecards and the escalation path before performance drifts.", output: "Supplier scorecard" },
  { name: "Spend and savings", body: "Category analysis, baseline discipline and savings that survive finance review.", output: "Savings tracker" }
];
const calculators = ["Should-cost build-up", "Total cost of ownership", "Payment-term impact", "Savings validation", "Supplier score weighting"];
const templates = ["Sourcing plan", "RFP scorecard", "Contract summary sheet", "Supplier review pack", "Category spend brief"];
const sequence = [
  { name: "Core HR", body: "Legal employer, business unit, grades and the person record everything else hangs from.", breaks: "Absence and payroll later fail on missing legal-employer or grade data." },
  { name: "Absence", body: "Plans, accruals and eligibility, built on the person record you just configured.", breaks: "Accruals calculate against the wrong plan if eligibility is set first." },
  { name: "Time and labour", body: "Time cards, shifts and approvals that feed payroll rather than duplicate it.", breaks: "Payroll receives time that never passed an approval rule." },
  { name: "Payroll", body: "Element eligibility, costing and the run sequence, tested against a small population.", breaks: "Elements attached to the wrong eligibility produce a silent zero." },
  { name: "Recruiting", body: "Requisitions, candidate selection and the handoff into the person record.", breaks: "Hires arrive without the grades the downstream modules expect." },
  { name: "Talent and learning", body: "Goals, performance and learning assignments that reference a stable job architecture.", breaks: "Goals attach to job codes that were never finalised." }
];
const labs = [
  { name: "Core HR lab", body: "Create a legal employer, a business unit and a grade ladder, then hire one person end to end." },
  { name: "Payroll lab", body: "Attach an element, run a small payroll and reconcile the costing against the general ledger." },
  { name: "Recruiting lab", body: "Open a requisition, move a candidate through selection and convert the hire into an employee record." }
];
---
<section class={`lp-hero lp--${variant}`} aria-labelledby="lp-title">
  <div class="shell lp-hero__inner">
    <div class="lp-hero__copy">
      <p class="t-label">{page.eyebrow}</p>
      <h1 id="lp-title">{page.lead}<br /><em>{page.accent}</em></h1>
      <p class="lp-hero__lede">{page.lede}</p>
      <div class="lp-hero__actions">
        <Button href={page.href} external ctaId="open-learning-platform">Open {page.label}</Button>
        <Button href="https://digitracks.net/products/" variant="secondary">Related products</Button>
      </div>
    </div>
    <aside class="lp-card" aria-label={`${page.label} access`}>
      <span class="lp-card__chip">{page.access}</span>
      <strong>{page.label}</strong>
      <a href={page.href}>{page.href.replace("https://", "").replace(/\/$/, "")}</a>
      <dl>{page.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <small>No account needed. Nothing is gated behind a sign-in.</small>
    </aside>
  </div>
</section>

{variant === "sourcecraft" && (
  <>
    <section class="lp-band" aria-labelledby="lp-terms">
      <div class="shell">
        <div class="section-head"><div><p class="t-label">01 / Glossary</p><h2 id="lp-terms">Six terms that decide the deal.</h2></div><p>Each entry gives the plain meaning first, then the question to ask before the clause is accepted.</p></div>
        <dl class="lp-terms">
          {terms.map((item, index) => (
            <div class="lp-term">
              <dt><span>{String(index + 1).padStart(2, "0")}</span>{item.term}</dt>
              <dd><p>{item.plain}</p><p class="lp-term__watch"><b>Ask:</b> {item.watch}</p></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
    <section class="lp-band lp-band--paper" aria-labelledby="lp-reading">
      <div class="shell">
        <div class="section-head"><div><p class="t-label">02 / Method</p><h2 id="lp-reading">Read one clause four ways.</h2></div><p>The same sequence works for a supply agreement, a licence or an order schedule.</p></div>
        <ol class="lp-steps">{reading.map((step, index) => (<li><span>{String(index + 1).padStart(2, "0")}</span><h3>{step.title}</h3><p>{step.body}</p></li>))}</ol>
      </div>
    </section>
    <section class="lp-note"><div class="shell lp-note__inner"><div><p class="t-label">03 / Regional lens</p><h2>Same words, different exposure.</h2></div><p>India, the United States, the United Kingdom and California each carry their own default rules on liability, termination and penalty. Switch the lens on any term to see the comparison before you take a position.</p></div></section>
  </>
)}

{variant === "learnpmo" && (
  <>
    <section class="lp-band" aria-labelledby="lp-levels">
      <div class="shell">
        <div class="section-head"><div><p class="t-label">01 / Curriculum</p><h2 id="lp-levels">Three levels, in order.</h2></div><p>Each level assumes the one before it. The modules inside a level can be read in any order.</p></div>
        <ol class="lp-levels">
          {levels.map((level) => (
            <li>
              <div class="lp-level__head"><span>{level.level}</span><h3>{level.name}</h3></div>
              <p>{level.body}</p>
              <ul>{level.modules.map((m) => <li>{m}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="lp-split" aria-labelledby="lp-exam">
      <div class="shell lp-split__grid">
        <div class="lp-split__block">
          <p class="t-label">02 / Mock exams</p>
          <h2 id="lp-exam">Practice the format, not just the content.</h2>
          <p>Scenario questions with one best answer, a rationale for every option, and a score review that points back at the lesson behind each miss. Retakes are open, so a weak topic can be revisited the same day.</p>
          <ul><li>Scenario-based questions, not recall</li><li>A rationale for every option, including the wrong ones</li><li>Topic breakdown after each attempt</li><li>Unlimited retakes from the direct link</li></ul>
        </div>
        <div class="lp-split__block lp-split__block--ink">
          <p class="t-label">03 / Simulator</p>
          <h2>A project you can break safely.</h2>
          <p>The practice simulator gives you a project, a sprint, a timesheet and a risk register. Change a baseline and watch what happens to the plan, then reset and try the decision another way.</p>
          <ul><li>Projects, sprints and timesheets</li><li>Charter, scope and decision log</li><li>RAID register and lessons learned</li><li>Everything saved in this browser</li></ul>
        </div>
      </div>
    </section>
  </>
)}

{variant === "procuresherpa" && (
  <>
    <section class="lp-band" aria-labelledby="lp-modules">
      <div class="shell">
        <div class="section-head"><div><p class="t-label">01 / Modules</p><h2 id="lp-modules">Six modules, six artefacts.</h2></div><p>Every module ends with the document or number a buyer has to produce anyway.</p></div>
        <ul class="lp-modules">
          {modules.map((item, index) => (<li><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.name}</h3><p>{item.body}</p><small>{item.output}</small></li>))}
        </ul>
      </div>
    </section>
    <section class="lp-split lp-split--light" aria-labelledby="lp-tools">
      <div class="shell lp-split__grid">
        <div class="lp-split__block">
          <p class="t-label">02 / Calculators</p>
          <h2 id="lp-tools">Numbers, not adjectives.</h2>
          <p>Each calculator takes your inputs and shows the working, so the figure can be defended in a review instead of asserted in a slide.</p>
          <ul>{calculators.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="lp-split__block">
          <p class="t-label">03 / Templates</p>
          <h2>Start from the document.</h2>
          <p>Templates are plain, editable and short enough to finish. Fill one in, save it locally, take it into the meeting.</p>
          <ul>{templates.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>
  </>
)}

{variant === "hcmfusion" && (
  <>
    <section class="lp-band" aria-labelledby="lp-sequence">
      <div class="shell">
        <div class="section-head"><div><p class="t-label">01 / Sequence</p><h2 id="lp-sequence">The order the modules depend on.</h2></div><p>Read down the list. Each row names the failure that appears when the step above it was skipped.</p></div>
        <ol class="lp-sequence">
          {sequence.map((item, index) => (
            <li>
              <span class="lp-sequence__num">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{item.name}</h3><p>{item.body}</p></div>
              <p class="lp-sequence__break"><b>If skipped:</b> {item.breaks}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="lp-band lp-band--paper" aria-labelledby="lp-labs">
      <div class="shell">
        <div class="section-head"><div><p class="t-label">02 / Labs</p><h2 id="lp-labs">One lab per module.</h2></div><p>Labs run in a practice environment. Notes are kept in this browser, so nothing has to be exported to keep it.</p></div>
        <ul class="lp-labs">{labs.map((lab, index) => (<li><span>{String(index + 1).padStart(2, "0")}</span><h3>{lab.name}</h3><p>{lab.body}</p><small>Practice lab · free to open</small></li>))}</ul>
      </div>
    </section>
  </>
)}

<section class="lp-boundary" aria-labelledby="lp-boundary">
  <div class="shell lp-boundary__grid">
    <div><p class="t-label">What this page is not</p><h2 id="lp-boundary">No gate, no upsell.</h2></div>
    <ul>
      <li>There is no account to create and no approval step. The button above opens the platform.</li>
      <li>Progress, notes and saved work live in this browser, not in a profile we hold.</li>
      <li>If you want a guided session with the team that wrote the material, that is a conversation, not a condition of access.</li>
    </ul>
  </div>
</section>

<section class="lp-close"><div class="shell lp-close__inner"><div><p class="t-label">Next step</p><h2>Open it, or ask us to walk it with you.</h2><p>Start with the module closest to the work in front of you. If it raises a question about a live decision, bring that question to the studio.</p></div><div class="lp-close__actions"><Button href={page.href} external ctaId="open-learning-platform">Open {page.label} ↗</Button><Button href={contactHref} variant="secondary">Ask the team</Button></div></div></section>

<style>
  .lp-hero { --lp-accent: #8a6114; background: linear-gradient(180deg, var(--paper-bright), var(--paper)); border-bottom: 1px solid rgb(13 27 46 / 12%); }
  .lp--sourcecraft { --lp-accent: #2f5da8; }
  .lp--learnpmo { --lp-accent: #8a6114; }
  .lp--procuresherpa { --lp-accent: #1f6f5c; }
  .lp--hcmfusion { --lp-accent: #a33d2f; }
  .lp-hero__inner { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; padding-block: clamp(3rem, 5.5vw, 5.4rem); }
  .lp-hero h1 { margin: 0.7rem 0 1.1rem; font-family: var(--font-display); font-size: clamp(2.8rem, 5.2vw, 4.8rem); font-weight: 500; letter-spacing: -0.045em; line-height: 0.96; color: var(--ink); }
  .lp-hero h1 em { font-family: var(--font-editorial); font-style: italic; color: var(--lp-accent); letter-spacing: -0.02em; }
  .lp-hero__lede { max-width: 58ch; margin: 0 0 1.5rem; color: var(--ink-muted); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.65; }
  .lp-hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .lp-card { display: grid; gap: 0.55rem; padding: 1.4rem 1.35rem; background: var(--paper-bright); border: 1px solid rgb(13 27 46 / 16%); border-top: 4px solid var(--lp-accent); }
  .lp-card__chip { justify-self: start; padding: 0.3rem 0.55rem; background: rgb(245 207 101 / 28%); color: #6d4c0f; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .lp-card strong { font-family: var(--font-display); font-size: 1.5rem; font-weight: 560; letter-spacing: -0.03em; color: var(--ink); }
  .lp-card a { color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.78rem; text-decoration: none; border-bottom: 1px solid rgb(13 27 46 / 30%); justify-self: start; }
  .lp-card dl { display: grid; gap: 0; margin: 0.5rem 0 0; border-top: 1px solid rgb(13 27 46 / 12%); }
  .lp-card dl > div { display: grid; grid-template-columns: minmax(5rem, 0.5fr) minmax(0, 1fr); gap: 0.8rem; padding: 0.5rem 0; border-bottom: 1px solid rgb(13 27 46 / 10%); }
  .lp-card dt { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; color: #6c7a8c; }
  .lp-card dd { margin: 0; color: var(--ink); font-size: 0.86rem; line-height: 1.45; }
  .lp-card small { color: #6c7a8c; font-size: 0.78rem; line-height: 1.5; }

  .lp-band { padding-block: clamp(2.8rem, 5vw, 4.6rem); }
  .lp-band--paper { background: var(--paper); border-block: 1px solid rgb(13 27 46 / 10%); }
  .lp-terms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 1.8rem 0 0; padding: 0; background: rgb(13 27 46 / 14%); }
  .lp-term { background: var(--paper-bright); padding: 1.4rem 1.4rem 1.3rem; }
  .lp-term dt { display: flex; gap: 0.7rem; align-items: baseline; font-family: var(--font-display); font-size: 1.24rem; font-weight: 560; letter-spacing: -0.02em; color: var(--ink); }
  .lp-term dt span { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em; color: var(--lp-accent); }
  .lp-term dd { margin: 0.6rem 0 0; }
  .lp-term dd p { margin: 0 0 0.6rem; color: var(--ink-muted); font-size: 0.94rem; line-height: 1.6; }
  .lp-term__watch { padding-top: 0.6rem; border-top: 1px solid rgb(13 27 46 / 10%); color: var(--ink) !important; font-size: 0.9rem !important; }
  .lp-term__watch b { font-weight: 600; color: var(--lp-accent); }

  .lp-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 1.8rem 0 0; padding: 0; list-style: none; background: rgb(13 27 46 / 14%); counter-reset: none; }
  .lp-steps li { display: grid; gap: 0.5rem; align-content: start; padding: 1.5rem 1.3rem; background: var(--paper-bright); }
  .lp-steps span { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; color: var(--lp-accent); }
  .lp-steps h3 { margin: 0; font-family: var(--font-display); font-size: 1.14rem; font-weight: 560; letter-spacing: -0.02em; color: var(--ink); }
  .lp-steps p { margin: 0; color: var(--ink-muted); font-size: 0.92rem; line-height: 1.58; }

  .lp-note { background: var(--night); color: var(--paper-bright); padding-block: clamp(2.6rem, 4.4vw, 4rem); }
  .lp-note__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .lp-note .t-label { color: var(--signal); }
  .lp-note h2 { margin: 0.5rem 0 0; font-family: var(--font-display); font-size: clamp(1.9rem, 3.2vw, 2.8rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.02; color: var(--paper-bright); }
  .lp-note p { margin: 0; color: rgb(198 212 230 / 88%); line-height: 1.65; }

  .lp-levels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 1.8rem 0 0; padding: 0; list-style: none; background: rgb(13 27 46 / 14%); }
  .lp-levels > li { display: grid; gap: 0.7rem; align-content: start; padding: 1.6rem 1.4rem; background: var(--paper-bright); }
  .lp-level__head { display: flex; gap: 0.7rem; align-items: baseline; }
  .lp-level__head span { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; color: var(--lp-accent); }
  .lp-level__head h3 { margin: 0; font-family: var(--font-display); font-size: 1.36rem; font-weight: 560; letter-spacing: -0.025em; color: var(--ink); }
  .lp-levels > li > p { margin: 0; color: var(--ink-muted); font-size: 0.92rem; line-height: 1.55; }
  .lp-levels ul { margin: 0.2rem 0 0; padding: 0; list-style: none; border-top: 1px solid rgb(13 27 46 / 12%); }
  .lp-levels ul li { padding: 0.5rem 0; border-bottom: 1px solid rgb(13 27 46 / 8%); color: var(--ink); font-size: 0.9rem; }

  .lp-split { background: var(--night); color: var(--paper-bright); padding-block: clamp(2.8rem, 5vw, 4.6rem); }
  .lp-split--light { background: var(--paper-bright); color: var(--ink); border-block: 1px solid rgb(13 27 46 / 12%); }
  .lp-split__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: rgb(198 212 230 / 22%); }
  .lp-split--light .lp-split__grid { background: rgb(13 27 46 / 14%); }
  .lp-split__block { padding: clamp(1.6rem, 3vw, 2.4rem); background: var(--night); }
  .lp-split--light .lp-split__block { background: var(--paper-bright); }
  .lp-split__block .t-label { color: var(--signal); }
  .lp-split--light .lp-split__block .t-label { color: var(--lp-accent); }
  .lp-split__block h2 { margin: 0.5rem 0 0.9rem; font-family: var(--font-display); font-size: clamp(1.7rem, 2.6vw, 2.3rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.02; color: var(--paper-bright); }
  .lp-split--light .lp-split__block h2 { color: var(--ink); }
  .lp-split__block p { margin: 0 0 1rem; color: rgb(198 212 230 / 86%); line-height: 1.62; }
  .lp-split--light .lp-split__block p { color: var(--ink-muted); }
  .lp-split__block ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(198 212 230 / 22%); }
  .lp-split--light .lp-split__block ul { border-top-color: rgb(13 27 46 / 14%); }
