---
import type { RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";

interface Props {
  route: RouteRecord;
}

const { route } = Astro.props;

const engagements = [
  {
    code: "01",
    title: "Product fit",
    intent: "consultation",
    summary: "Find the product and deployment model that fit the workflow, before anyone commits to a rollout.",
    scope: ["Users, workflow and constraints mapped", "Published scope compared with your requirement", "Deployment, licence and integration questions recorded"],
    outcome: "A shortlist, a deployment model and a rollout plan.",
    cta: "Scope a rollout"
  },
  {
    code: "02",
    title: "Implementation",
    intent: "consultation",
    summary: "Configure the product around your operating model, connect it to the systems you keep, and train the team that runs it.",
    scope: ["Target operating model confirmed", "Roles, data and integrations configured", "Training and go-live checklist agreed"],
    outcome: "A configured system, trained users and a go-live date.",
    cta: "Discuss implementation"
  },
  {
    code: "03",
    title: "Migration",
    intent: "migration",
    summary: "Move records, history and open work across with a reconciliation step that proves nothing was lost on the way.",
    scope: ["Source records and quality inventoried", "Mapping and reconciliation rules defined", "Validation, rollback and ownership planned"],
    outcome: "Reconciled data, a rehearsed cutover and a rollback path.",
    cta: "Plan a migration"
  },
  {
    code: "04",
    title: "Support",
    intent: "support",
    summary: "Keep the system running with a named route for issues, a clear escalation path and upgrades that do not surprise the team.",
    scope: ["Impact and affected workflow identified", "Diagnostics and environment captured once", "Owner and response window confirmed"],
    outcome: "A named contact, an agreed response window and an upgrade path.",
    cta: "Request support"
  }
] as const;

const sequence = [
  ["Discover", "Walk the workflow with the people who run it, and record the constraints that will shape the deployment."],
  ["Define", "Write down the scope, the roles, the integrations and what a successful rollout looks like."],
  ["Configure", "Set up the product, connect data, and test against the requirements already agreed."],
  ["Validate", "Run acceptance checks with your team on real scenarios before anything goes live."],
  ["Go live", "Cut over with a plan, a rollback path and support that is already in place."]
] as const;

const shapes = [
  { title: "Licence", body: "Per user or per site, sized to the team that uses the product. Quoted per product, not as a platform-wide subscription." },
  { title: "Implementation", body: "Fixed-scope configuration, migration and training. Quoted separately from the licence so the work is visible on its own line." },
  { title: "Support", body: "A named route, an agreed response window and upgrades included or itemised — chosen per product and confirmed in writing." }
] as const;
---

<section class="services-hero" aria-labelledby="services-title">
  <div class="services-hero__index" aria-hidden="true">S/04</div>
  <div class="shell services-hero__grid">
    <div>
      <p class="t-label"><span class="signal-dot" aria-hidden="true"></span>Services / product fit, implementation, migration and support</p>
      <h1 id="services-title">From first demo<br><em>to live operation.</em></h1>
    </div>
    <div class="services-hero__copy">
      <p>We scope the work around your workflow, agree what done looks like, and stay through rollout. One team from the first conversation to production support.</p>
      <p>Most engagements start with a product question and end with a deployed system, a migrated dataset or a support route that answers inside an agreed window.</p>
      <div class="button-row"><Button href="/contact/?intent=consultation" ctaId="request-conversation">Book a scoping call</Button><Button href="#services-engagements" variant="secondary">See engagement paths</Button></div>
    </div>
  </div>
  <div class="shell services-hero__foot"><span>Workflow first</span><span>Named owner</span><span>Acceptance agreed up front</span><span>Support from day one</span></div>
</section>

<section class="services-engagements section" id="services-engagements" aria-labelledby="services-engagements-title">
  <div class="shell">
    <div class="section-head"><div><p class="t-label">01 / Engagement paths</p><h2 id="services-engagements-title">Four ways to work with us.</h2></div><p>Start where the decision is. Each path has a defined outcome, a scope you approve and an owner on our side.</p></div>
    <ol class="services-engagement-grid">
      {engagements.map((engagement) => <li>
        <article>
          <div class="services-engagement-card__head"><span>{engagement.code}</span><i aria-hidden="true"></i></div>
          <h3>{engagement.title}</h3>
          <p>{engagement.summary}</p>
          <ul>{engagement.scope.map((item) => <li>{item}</li>)}</ul>
          <p class="services-outcome">{engagement.outcome}</p>
          <Button href={`/contact/?intent=${engagement.intent}`} variant="secondary" ctaId="request-conversation">{engagement.cta}</Button>
        </article>
      </li>)}
    </ol>
  </div>
</section>

<section class="services-sequence section" aria-labelledby="services-sequence-title">
  <div class="shell services-sequence__grid">
    <div><p class="t-label">02 / Working sequence</p><h2 id="services-sequence-title">Five steps to go live.</h2><p>The same sequence runs every engagement, so your team always knows what happens next and who owns it.</p></div>
    <ol>{sequence.map(([title, description], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}</ol>
  </div>
</section>

<section class="services-boundary section" aria-labelledby="services-boundary-title">
  <div class="shell services-boundary__grid">
    <div><p class="t-label">03 / Commercials</p><h2 id="services-boundary-title">Three lines on every quote.</h2><p class="services-boundary__lede">Licence, implementation and support are priced separately, so the number is easy to read and easy to defend.</p></div>
    <div class="prose services-shapes">
      {shapes.map((shape) => <div class="services-shape"><h3>{shape.title}</h3><p>{shape.body}</p></div>)}
      <Button href="/contact/?intent=consultation" variant="secondary" ctaId="request-conversation">Request a scoped proposal</Button>
    </div>
  </div>
</section>

<section class="services-brief section" aria-labelledby="services-brief-title">
  <div class="shell services-brief__grid">
    <div class="services-brief__mark" aria-hidden="true"><span>ENGAGEMENT BRIEF</span><strong>04</strong><small>Discover · Define · Configure · Validate · Go live</small></div>
    <div><p class="t-label">04 / What to bring</p><h2 id="services-brief-title">Four details make the first call useful.</h2><ul><li>The workflow you need to change, and the product you are considering.</li><li>The tools it has to work with, and where it will be hosted.</li><li>The teams involved, who decides, and what happens if it slips.</li><li>The data volume, integrations and acceptance criteria you care about.</li></ul><p>That is enough to scope the work. Production data stays in your environment — we will never ask for it to open a conversation.</p><Button href="/contact/?intent=consultation" ctaId="request-conversation">Prepare an enquiry</Button></div>
  </div>
</section>

<section class="services-close" aria-labelledby="services-close-title">
  <div class="shell services-close__grid"><div><p class="t-label">Next step</p><h2 id="services-close-title">Tell us what needs to change.</h2></div><div><p>Whether you need to choose a product, implement it, migrate to it or support it, the first call ends with a scope, an owner and a date.</p><div class="on-night"><Button href="/contact/?intent=consultation" ctaId="request-conversation">Start a conversation</Button></div></div></div>
</section>

<style>
  .services-outcome {
    margin: 0 0 0.2rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgb(13 27 46 / 12%);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 550;
    line-height: 1.45;
  }
  .services-boundary__lede { max-width: 34ch; margin-top: 1rem; color: #4a5567; line-height: 1.55; }
  .services-shapes { display: grid; gap: 0; border-top: 1px solid rgb(13 27 46 / 14%); }
  .services-shape { display: grid; grid-template-columns: minmax(8rem, 0.5fr) minmax(0, 1.5fr); gap: 1.5rem; padding: 1.15rem 0; border-bottom: 1px solid rgb(13 27 46 / 14%); }
  .services-shape h3 { margin: 0; font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .services-shape p { margin: 0; color: #46536a; line-height: 1.6; }
  .services-shapes :global(.button) { margin-top: 1.2rem; justify-self: start; }
  @media (max-width: 720px) { .services-shape { grid-template-columns: 1fr; gap: 0.3rem; } }

  .services-hero h1 em { color: var(--signal); }
  .services-engagement-grid > li article { border-top: 4px solid var(--eng-accent, #e0b64a); background: #fffdf6; }
  .services-engagement-grid > li:nth-child(1) article { --eng-accent: #e0b64a; }
  .services-engagement-grid > li:nth-child(2) article { --eng-accent: #2f5da8; }
  .services-engagement-grid > li:nth-child(3) article { --eng-accent: #2f7f68; }
  .services-engagement-grid > li:nth-child(4) article { --eng-accent: #a9573c; }
  .services-engagement-grid > li:nth-child(2) { background: #f2f5f9; }
  .services-engagement-grid > li:nth-child(3) { background: #edf6f1; }
  .services-engagement-grid > li:nth-child(4) { background: #fbf0ea; }
  .services-engagement-card__head span { color: #8a6114; }
  .services-sequence { background: #f8f4e8; }
  .services-sequence__grid > div { position: sticky; top: 6.5rem; align-self: start; }
  .services-sequence__grid ol li span { color: #8a6114; font-weight: 600; }
  .services-shape { border-left: 3px solid #e0b64a; padding-left: 1rem; }
  .services-shape:nth-child(2) { border-left-color: #2f5da8; }
  .services-shape:nth-child(3) { border-left-color: #2f7f68; }
</style>
