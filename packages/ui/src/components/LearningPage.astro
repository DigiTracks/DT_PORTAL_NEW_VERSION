---
import type { RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";
import LearningLaunch from "./LearningLaunch.astro";

interface Props {
  route: RouteRecord;
}

const { route } = Astro.props;
const launchRoutes = new Set(["/sourcecraft/", "/learnpmo/", "/procuresherpa/", "/hcmfusion/"]);
const isContact = route.path === "/contact/";
const isLaunch = launchRoutes.has(route.path);
const name = route.title.replace(" | Digi Tracks", "");
const contactHref = `https://digitracks.net/contact/?intent=consultation&origin=${route.origin}&route=${encodeURIComponent(route.path)}`;
---

{isLaunch ? (
  <LearningLaunch route={route} />
) : isContact ? (
<section class="learning-entry" aria-labelledby="learning-entry-title">
  <div class="shell learning-entry__hero">
    <div><p class="t-label">Digi Tracks learning / contact</p><h1 id="learning-entry-title">Ask the studio<em> directly.</em></h1><p class="learning-entry__lede">Questions about a platform, a learning path or a product decision go to the same team that builds the software.</p></div>
    <div class="learning-entry__stamp" aria-hidden="true"><span>LEARN</span><strong>DT</strong><small>DIGITRACKS / LEARN</small></div>
  </div>
  <div class="shell learning-entry__body">
    <aside><p class="t-label">Platforms</p><a href="https://sourcecraft.digitracks.net/">SourceCraft</a><a href="https://learnpmo.digitracks.net/">LearnPMO</a><a href="https://procuresherpa.digitracks.net/">ProcureSherpa</a><a href="https://hcmfusion.digitracks.net/">HCM Fusion</a></aside>
    <div class="prose">
      <h2>One conversation, the right link.</h2>
      <p>Every public learning page is open. If you want a guided walkthrough, a team session or help choosing between platforms, tell us the workflow and we will point you to the exact page.</p>
      <Button href={contactHref} ctaId="learning-contact">Contact the studio</Button>
    </div>
  </div>
</section>
) : (
<section class="learning-entry" aria-labelledby="learning-entry-title">
  <div class="shell learning-entry__hero">
    <div><p class="t-label">Digi Tracks learning</p><h1 id="learning-entry-title">{name}</h1><p class="learning-entry__lede">{route.description}</p></div>
    <div class="learning-entry__stamp" aria-hidden="true"><span>LEARN</span><strong>DT</strong><small>DIGITRACKS / LEARN</small></div>
  </div>
  <div class="shell learning-entry__body">
    <aside><p class="t-label">Platforms</p><a href="https://sourcecraft.digitracks.net/">SourceCraft</a><a href="https://learnpmo.digitracks.net/">LearnPMO</a><a href="https://procuresherpa.digitracks.net/">ProcureSherpa</a><a href="https://hcmfusion.digitracks.net/">HCM Fusion</a></aside>
    <div class="prose">
      <h2>Public pages, open links.</h2>
      <p>Every learning platform is free to open. Choose the one that matches the work in front of you and follow the direct link.</p>
    </div>
  </div>
</section>
)}
