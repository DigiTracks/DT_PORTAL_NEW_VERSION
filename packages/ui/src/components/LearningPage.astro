---
import type { RouteRecord } from "@digitracks/seo";
import Button from "./Button.astro";
import ProcurementLearning from "./ProcurementLearning.astro";

interface Props {
  route: RouteRecord;
}

const { route } = Astro.props;
const isContact = route.path === "/contact/";
const isProcurementLearning = route.template === "procurement-learning";
const name = route.title.replace(" | Digi Tracks", "");

const platforms: Record<string, { label: string; href: string; access: string; blurb: string; points: string[] }> = {
  "/sourcecraft/": {
    label: "SourceCraft",
    href: "https://sourcecraft.digitracks.net/",
    access: "Free reference — open in the browser",
    blurb: "A field guide to better buying: procurement and contract language explained plainly, with a regional lens for India, the United States, the United Kingdom and California.",
    points: [
      "Terms, clauses and comparisons explained in plain language",
      "Regional reference lenses for India, the US, the UK and California",
      "Saved terms so a working glossary follows you between pages"
    ]
  },
  "/learnpmo/": {
    label: "LearnPMO",
    href: "https://learnpmo.digitracks.net/",
    access: "Academy and labs — sign in to save progress",
    blurb: "PM360 Academy: project, programme and portfolio delivery taught through lessons, mock exams and a practice simulator rather than slideware.",
    points: [
      "Academy lessons, study plans and mock exams",
      "Practice simulator with projects, sprints and timesheets",
      "PMO registers: charter, scope, decision log, risks and lessons learned"
    ]
  },
  "/procuresherpa/": {
    label: "ProcureSherpa Learning",
    href: "https://procuresherpa.digitracks.net/",
    access: "Open modules, calculators and templates",
    blurb: "A procurement learning platform built around the work: academy modules, calculators, SOPs, checklists and scenarios you can apply the same week.",
    points: [
      "Academy modules across sourcing, contracts and spend",
      "Calculators, checklists and SOPs for day-to-day buying",
      "Scenario practice with locally saved work"
    ]
  },
  "/hcmfusion/": {
    label: "HCM Fusion",
    href: "https://hcmfusion.digitracks.net/",
    access: "Read every lesson without an account",
    blurb: "HCM Studio for Oracle Fusion Cloud HCM: Core HR, absence, time and labour, payroll, recruiting and talent, taught in configuration order with practice labs.",
    points: [
      "Core HR, Absence, Time and Labor, Payroll and Recruiting",
      "Talent, Learning, Compensation and Workforce Monitoring",
      "Configuration order, the failures it prevents, and practice labs"
    ]
  }
};

const platform = platforms[route.path];
const contactHref = `https://digitracks.net/contact/?intent=consultation&origin=${route.origin}&route=${encodeURIComponent(route.path)}`;
---

{isProcurementLearning ? (
  <ProcurementLearning route={route} />
) : isContact ? (
<section class="learning-entry" aria-labelledby="learning-entry-title">
  <div class="shell learning-entry__hero">
    <div><p class="t-label">Digi Tracks learning / contact</p><h1 id="learning-entry-title">Ask the studio<em> directly.</em></h1><p class="learning-entry__lede">Questions about a platform, a learning path or a product decision go to the same team that builds the software.</p></div>
    <div class="learning-entry__stamp" aria-hidden="true"><span>LEARN</span><strong>DT</strong><small>DIGITRACKS / LEARN</small></div>
  </div>
  <div class="shell learning-entry__body">
    <aside><p class="t-label">Platforms</p><a href="https://sourcecraft.digitracks.net/">SourceCraft</a><a href="https://learnpmo.digitracks.net/">LearnPMO</a><a href="https://procuresherpa.digitracks.net/">ProcureSherpa</a><a href="https://hcmfusion.digitracks.net/">HCM Fusion</a></aside>
    <div class="prose">
      <h2>One conversation, the right link.</h2>
      <p>Every public learning page is open. If you want a guided walkthrough, a team session or help choosing between platforms, tell us the workflow and we will point you to the exact page.</p>
      <Button href={contactHref} ctaId="learning-contact">Contact the studio</Button>
    </div>
  </div>
</section>
) : platform ? (
<section class="learning-entry learning-entry--platform" aria-labelledby="learning-entry-title">
  <div class="shell learning-entry__hero">
    <div>
      <p class="t-label">Digi Tracks learning / platform</p>
      <h1 id="learning-entry-title">{platform.label}<em> is open.</em></h1>
      <p class="learning-entry__lede">{platform.blurb}</p>
      <div class="button-row">
        <Button href={platform.href} external ctaId="open-learning-platform">Open {platform.label}</Button>
        <Button href="https://digitracks.net/products/" variant="secondary">See related products</Button>
      </div>
    </div>
    <div class="learning-entry__stamp"><span>{platform.label} / direct link</span><strong aria-hidden="true">↗</strong><a href={platform.href}>{platform.href.replace("https://", "").replace(/\/$/, "")}</a><small>{platform.access}</small></div>
  </div>
  <div class="shell learning-entry__body">
    <aside><p class="t-label">On this page</p><a href="#learning-entry-next">What you will find</a><a href={platform.href}>Open the platform</a><a href="https://digitracks.net/products/">Product catalogue</a></aside>
    <div class="prose">
      <h2 id="learning-entry-next">Go straight in.</h2>
      <p>No account is needed to read the public pages. The link above opens {platform.label} directly — the same material our team uses when scoping a piece of work.</p>
      <ul>{platform.points.map((point) => <li>{point}</li>)}</ul>
      <h2>Bring a real question.</h2>
      <p>Pick a live clause, plan or process you are working on and follow it through the platform. If you want that walkthrough with our team, book a session and we will use your example, not a demo script.</p>
      <Button href={platform.href} external ctaId="open-learning-platform">Open {platform.label} ↗</Button>
    </div>
  </div>
</section>
) : (
<section class="learning-entry" aria-labelledby="learning-entry-title">
  <div class="shell learning-entry__hero">
    <div><p class="t-label">Digi Tracks learning</p><h1 id="learning-entry-title">{name}</h1><p class="learning-entry__lede">{route.description}</p></div>
    <div class="learning-entry__stamp" aria-hidden="true"><span>LEARN</span><strong>DT</strong><small>DIGITRACKS / LEARN</small></div>
  </div>
  <div class="shell learning-entry__body">
    <aside><p class="t-label">Platforms</p><a href="https://sourcecraft.digitracks.net/">SourceCraft</a><a href="https://learnpmo.digitracks.net/">LearnPMO</a><a href="https://procuresherpa.digitracks.net/">ProcureSherpa</a><a href="https://hcmfusion.digitracks.net/">HCM Fusion</a></aside>
    <div class="prose">
      <h2>Public pages, open links.</h2>
      <p>Every learning platform is readable without an account. Choose the one that matches the work in front of you and open it directly.</p>
    </div>
  </div>
</section>
)}